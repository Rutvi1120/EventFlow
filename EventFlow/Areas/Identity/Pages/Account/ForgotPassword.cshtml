@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="ef-auth-page">
    <div class="ef-auth-card">
        <div class="ef-auth-header">
            <div class="ef-auth-logo">EF</div>

            <h1>Forgot your password?</h1>

            <p>
                Enter your email address and we'll help you reset your password.
            </p>
        </div>

        <form method="post" class="ef-auth-form">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"
                 role="alert"></div>

            <div class="ef-form-group">
                <label asp-for="Input.Email"></label>

                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="email"
                       placeholder="Enter your email" />

                <span asp-validation-for="Input.Email"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-primary ef-auth-submit">
                Send Reset Instructions
            </button>
        </form>

        <div class="ef-auth-footer">
            <span>Remember your password?</span>

            <a asp-page="./Login">
                Sign In
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}