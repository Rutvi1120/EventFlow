@page
@model ForgotPasswordConfirmation

@{
    ViewData["Title"] = "Check Your Email";
}

<div class="ef-auth-page">
    <div class="ef-auth-card">
        <div class="ef-auth-header">
            <div class="ef-auth-logo">EF</div>

            <h1>Check your email</h1>

            <p>
                If an account with that email exists, password reset instructions have been sent.
            </p>
        </div>

        <div class="ef-auth-help">
            Check your inbox and follow the password reset link.
            If you don't see the message, check your spam or junk folder.
        </div>

        <div class="ef-auth-footer">
            <span>Remember your password?</span>

            <a asp-page="./Login">
                Sign In
            </a>
        </div>
    </div>
</div>