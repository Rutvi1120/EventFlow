@page
@model LoginModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="ef-auth-page">
    <div class="ef-auth-card">
        <div class="ef-auth-header">
            <div class="ef-auth-logo">EF</div>

            <h1>Welcome back</h1>

            <p>
                Sign in to continue to EventFlow.
            </p>
        </div>

        @if (TempData["RegistrationSuccess"] != null)
        {
            <div class="alert alert-success" role="alert">
                @TempData["RegistrationSuccess"]
            </div>
        }

        <form method="post" class="ef-auth-form">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"
                 role="alert"></div>

            <div class="ef-form-group">
                <label asp-for="Input.Email"></label>

                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       placeholder="Enter your email" />

                <span asp-validation-for="Input.Email"
                      class="text-danger"></span>
            </div>

            <div class="ef-form-group">
                <label asp-for="Input.Password"></label>

                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="current-password"
                       placeholder="Enter your password" />

                <span asp-validation-for="Input.Password"
                      class="text-danger"></span>
            </div>

            <div class="ef-auth-options">
                <div class="form-check">
                    <input asp-for="Input.RememberMe"
                           class="form-check-input" />

                    <label asp-for="Input.RememberMe"
                           class="form-check-label">
                    </label>
                </div>

                <a asp-page="./ForgotPassword">
                    Forgot password?
                </a>
            </div>

            <button type="submit"
                    class="btn btn-primary ef-auth-submit">
                Sign In
            </button>
        </form>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="ef-auth-divider">
                <span>or</span>
            </div>

            <form asp-page="./Login"
                  asp-page-handler="ExternalLogin"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post"
                  class="ef-external-login">

                @foreach (var provider in Model.ExternalLogins)
                {
                    <button type="submit"
                            class="btn btn-outline-secondary w-100"
                            name="provider"
                            value="@provider.Name">
                        Continue with @provider.DisplayName
                    </button>
                }
            </form>
        }

        <div class="ef-auth-footer">
            <span>Don't have an account?</span>

            <a asp-page="./Register"
               asp-route-returnUrl="@Model.ReturnUrl">
                Create Account
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}