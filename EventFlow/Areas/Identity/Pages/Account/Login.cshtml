@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="ef-auth-page">
    <div class="ef-auth-background"></div>

    <div class="ef-auth-card">

        <div class="ef-auth-logo">
            <a asp-controller="Home" asp-action="Index" class="ef-brand">
                <span class="ef-brand-icon">E</span>
            </a>
        </div>

        <div class="ef-auth-heading">
            <h1>Welcome back</h1>
            <p>Sign in to continue to EventFlow</p>
        </div>

        <form id="account" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="ef-auth-error"
                 role="alert"></div>

            <div class="ef-input-group">
                <label asp-for="Input.Email">Email address</label>
                <input asp-for="Input.Email"
                       class="ef-auth-input"
                       autocomplete="username"
                       placeholder="Enter your email" />
                <span asp-validation-for="Input.Email"
                      class="ef-validation"></span>
            </div>

            <div class="ef-input-group">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password"
                       class="ef-auth-input"
                       autocomplete="current-password"
                       placeholder="Enter your password" />
                <span asp-validation-for="Input.Password"
                      class="ef-validation"></span>
            </div>

            <div class="ef-login-options">
                <label class="ef-remember">
                    <input asp-for="Input.RememberMe" />
                    <span>Remember me</span>
                </label>

                <a asp-page="./ForgotPassword"
                   class="ef-forgot-link">
                    Forgot password?
                </a>
            </div>

            <button id="login-submit"
                    type="submit"
                    class="ef-auth-submit">
                <span>Sign in</span>
                <span class="ef-submit-arrow">→</span>
            </button>

        </form>

        <div class="ef-auth-divider">
            <span>NEW TO EVENTFLOW?</span>
        </div>

        <a asp-page="./Register"
           asp-route-returnUrl="@Model.ReturnUrl"
           class="ef-auth-register-link">
            <span>Create an account</span>
            <span>→</span>
        </a>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
 
