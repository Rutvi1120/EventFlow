
@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="ef-auth-page ef-register-page">
    <div class="ef-auth-background"></div>

    <div class="ef-auth-card ef-register-card">

        <div class="ef-auth-logo">
            <a asp-controller="Home" asp-action="Index" class="ef-brand">
                <span class="ef-brand-icon">E</span>
            </a>
        </div>

        <div class="ef-auth-heading">
            <h1>Create your account</h1>
            <p>Join EventFlow and manage your events easily</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="ef-auth-error"
                 role="alert"></div>

            <div class="ef-input-group">
                <label asp-for="Input.Email">Email address</label>
                <input asp-for="Input.Email"
                       class="ef-auth-input"
                       autocomplete="username"
                       placeholder="Enter your email" />
                <span asp-validation-for="Input.Email"
                      class="ef-validation"></span>
            </div>

            <div class="ef-input-group">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password"
                       class="ef-auth-input"
                       autocomplete="new-password"
                       placeholder="Create a password" />
                <span asp-validation-for="Input.Password"
                      class="ef-validation"></span>
            </div>

            <div class="ef-input-group">
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <input asp-for="Input.ConfirmPassword"
                       class="ef-auth-input"
                       autocomplete="new-password"
                       placeholder="Confirm your password" />
                <span asp-validation-for="Input.ConfirmPassword"
                      class="ef-validation"></span>
            </div>

            <button id="registerSubmit"
                    type="submit"
                    class="ef-auth-submit">
                <span>Create account</span>
                <span class="ef-submit-arrow">→</span>
            </button>

        </form>

        <div class="ef-auth-divider">
            <span>ALREADY HAVE AN ACCOUNT?</span>
        </div>

        <a asp-page="./Login"
           asp-route-returnUrl="@Model.ReturnUrl"
           class="ef-auth-register-link">
            <span>Sign in to EventFlow</span>
            <span>→</span>
        </a>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
 
