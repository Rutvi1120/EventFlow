@model IEnumerable<EventFlow.Models.Club>

@{
    ViewData["Title"] = "My Clubs";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="fw-bold">My Clubs</h1>

        <p class="text-muted mb-0">
            Manage the clubs you are responsible for.
        </p>
    </div>

    <partial name="_Alerts" />

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">

                <div class="text-center py-4">

                    <h5 class="fw-bold">
                        No clubs found
                    </h5>

                    <p class="text-muted mb-0">
                        You currently do not have any approved clubs.
                    </p>

                </div>

            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var club in Model)
            {
                var clubEventCount =
                    club.Events?.Count ?? 0;

                <div class="col-md-6 col-xl-4">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body p-4 d-flex flex-column">

                            <div class="mb-3">

                                <h4 class="fw-bold mb-2">
                                    @club.Name
                                </h4>

                                <span class="badge bg-success">
                                    @club.Status
                                </span>

                            </div>

                            @if (club.FacultySupervisor != null)
                            {
                                <p class="text-muted mb-2">
                                    <strong>Faculty Supervisor:</strong>
                                    @club.FacultySupervisor.FullName
                                </p>
                            }

                            <p class="text-muted mb-4">
                                <strong>Events:</strong>
                                @clubEventCount
                            </p>

                            <div class="mt-auto">

                                <div class="d-grid gap-2">

                                    <!-- CREATE EVENT -->
                                    <a asp-controller="ClubPresident"
                                       asp-action="CreateEvent"
                                       asp-route-clubId="@club.Id"
                                       class="btn btn-primary">
                                        Create Event
                                    </a>

                                    <!-- CLUB DETAILS -->
                                    <a asp-controller="ClubPresident"
                                       asp-action="ClubDetails"
                                       asp-route-id="@club.Id"
                                       class="btn btn-outline-secondary">
                                        View Club
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>