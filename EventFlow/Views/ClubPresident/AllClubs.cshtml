@model IEnumerable<EventFlow.Models.Club>

@{
    ViewData["Title"] = "My Clubs";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>My Clubs</h1>
        <p class="text-muted">
            Clubs where you have been approved as club president.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You are not currently assigned as president of any club.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var club in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-success">
                                    Approved
                                </span>
                            </div>

                            <h4>@club.Name</h4>

                            <p class="text-muted">
                                @(club.Description ?? "No description available.")
                            </p>

                            <div class="mb-3">
                                <strong>Department:</strong>
                                @(club.Department ?? "Not specified")
                            </div>

                            <div class="mb-3">
                                <strong>Faculty Supervisor:</strong>
                                @(club.FacultySupervisor?.FullName ?? "Not assigned")
                            </div>

                            <div class="mt-auto">
                                <a asp-action="ClubDetails"
                                   asp-route-id="@club.Id"
                                   class="btn btn-primary w-100">
                                    Manage Club
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>