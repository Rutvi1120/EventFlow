@model EventFlow.Models.Club

@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="AllClubs"
           class="text-decoration-none">
            ← Back to My Clubs
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="mb-3">
                        <span class="badge bg-success">
                            Approved
                        </span>
                    </div>

                    <h1>@Model.Name</h1>

                    <p class="text-muted">
                        @(Model.Description ?? "No description available.")
                    </p>

                    <hr />

                    <div class="mb-3">
                        <strong>Department</strong>
                        <div>
                            @(Model.Department ?? "Not specified")
                        </div>
                    </div>

                    <div class="mb-3">
                        <strong>Club President</strong>
                        <div>
                            @(Model.ClubPresident?.FullName ?? "Not assigned")
                        </div>
                    </div>

                    <div>
                        <strong>Faculty Supervisor</strong>
                        <div>
                            @(Model.FacultySupervisor?.FullName ?? "Not assigned")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h3 class="mb-1">Club Events</h3>
                            <p class="text-muted mb-0">
                                Events organized by your club.
                            </p>
                        </div>

                        <a asp-action="CreateEvent"
                           asp-route-clubId="@Model.Id"
                           class="btn btn-primary">
                            Create Event
                        </a>
                    </div>

                    @if (!Model.Events.Any())
                    {
                        <div class="alert alert-info">
                            Your club has not created any events yet.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Event</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var eventItem in Model.Events)
                                    {
                                        <tr>
                                            <td>
                                                <strong>
                                                    @eventItem.Name
                                                </strong>
                                            </td>

                                            <td>
                                                @eventItem.StartDateTime.ToString("dd MMM yyyy")
                                            </td>

                                            <td>
                                                @if (eventItem.ApprovalStatus == "Approved")
                                                {
                                                    <span class="badge bg-success">
                                                        Approved
                                                    </span>
                                                }
                                                else if (eventItem.ApprovalStatus == "Rejected")
                                                {
                                                    <span class="badge bg-danger">
                                                        Rejected
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        Pending
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                @if (eventItem.ApprovalStatus == "Approved")
                                                {
                                                    <a asp-controller="Events"
                                                       asp-action="Details"
                                                       asp-route-id="@eventItem.Id"
                                                       class="btn btn-sm btn-outline-primary">
                                                        Details
                                                    </a>
                                                }
                                                else
                                                {
                                                    <div class="d-flex gap-2">
                                                        <a asp-action="EditEvent"
                                                           asp-route-id="@eventItem.Id"
                                                           class="btn btn-sm btn-outline-secondary">
                                                            Edit
                                                        </a>

                                                        <form asp-action="DeleteEvent"
                                                              method="post">
                                                            <input type="hidden"
                                                                   name="id"
                                                                   value="@eventItem.Id" />

                                                            <button type="submit"
                                                                    class="btn btn-sm btn-outline-danger">
                                                                Delete
                                                            </button>
                                                        </form>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>