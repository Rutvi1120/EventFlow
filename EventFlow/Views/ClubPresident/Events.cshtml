@model IEnumerable<EventFlow.Models.Event>

@{
    ViewData["Title"] = "Club Events";

    var manageableIds =
        ViewBag.ManageableEventIds as HashSet<int>
        ?? new HashSet<int>();
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Club Events</h1>
            <p class="text-muted mb-0">
                Manage events organized by your clubs.
            </p>
        </div>
    </div>

    <div class="mb-3 d-flex gap-2 align-items-center">
        <input id="club-events-search" class="form-control" style="max-width:360px;" type="search" placeholder="Search events..." />

        <div class="btn-group" role="group" aria-label="Filter events">
            <button type="button" class="btn btn-outline-secondary btn-sm club-events-filter active" data-filter="all">All</button>
            <button type="button" class="btn btn-outline-secondary btn-sm club-events-filter" data-filter="upcoming">Upcoming</button>
            <button type="button" class="btn btn-outline-secondary btn-sm club-events-filter" data-filter="ongoing">Ongoing</button>
            <button type="button" class="btn btn-outline-secondary btn-sm club-events-filter" data-filter="completed">Completed</button>
        </div>
    </div>

    <partial name="_Alerts" />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Your clubs have not organized any events yet.
        </div>
    }
    else
    {
        <div class="table-responsive" id="club-events-list">
            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Club</th>
                        <th>Date</th>
                        <th>Approval</th>
                        <th>Participants</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var eventItem in Model)
                    {
                        var startIso = eventItem.StartDateTime.ToString("o");
                        var endIso = eventItem.EndDateTime.ToString("o");

                        <tr class="event-row" data-name="@eventItem.Name.ToLower()" data-start="@startIso" data-end="@endIso">

                            <td>
                                <strong>
                                    @eventItem.Name
                                </strong>
                            </td>

                            <td>
                                @(eventItem.Club?.Name
                                    ?? eventItem.ClubName
                                    ?? "Unknown")
                            </td>

                            <td>
                                @eventItem.StartDateTime.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (eventItem.ApprovalStatus == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (eventItem.ApprovalStatus == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                            </td>

                            <td>
                                @eventItem.Registrations.Count /
                                @eventItem.MaxParticipants
                            </td>

                            <td>
                                <div class="d-flex justify-content-end gap-2">

                                    @if (eventItem.ApprovalStatus == "Approved")
                                    {
                                        <a asp-controller="Events"
                                           asp-action="Details"
                                           asp-route-id="@eventItem.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>
                                    }

                                    @if (eventItem.ApprovalStatus == "Approved" &&
                                         manageableIds.Contains(eventItem.Id))
                                    {
                                        <a asp-controller="Volunteer"
                                           asp-action="EventVolunteers"
                                           asp-route-eventId="@eventItem.Id"
                                           class="btn btn-sm btn-outline-success">
                                            Volunteers
                                        </a>
                                    }

                                    @if (eventItem.ApprovalStatus != "Approved")
                                    {
                                        <a asp-action="EditEvent"
                                           asp-route-id="@eventItem.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>

                                        <form asp-action="DeleteEvent"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@eventItem.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Are you sure you want to delete this event?');">
                                                Delete
                                            </button>

                                        </form>
                                    }

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        </div>
    }

    <script>
        (function(){
            const input = document.getElementById('club-events-search');
            const filters = document.querySelectorAll('.club-events-filter');

            function computeStatus(start, end){
                const now = new Date();
                if (now < start) return 'upcoming';
                if (now >= start && now <= end) return 'ongoing';
                return 'completed';
            }

            function applyFilter(){
                const q = input.value.trim().toLowerCase();
                const active = document.querySelector('.club-events-filter.active')?.dataset.filter || 'all';
                document.querySelectorAll('#club-events-list .event-row').forEach(el=>{
                    const name = (el.dataset.name || '').toLowerCase();
                    const start = new Date(el.dataset.start);
                    const end = new Date(el.dataset.end);
                    const status = computeStatus(start,end);

                    const matchesSearch = q === '' || name.indexOf(q) !== -1;
                    const matchesFilter = active === 'all' || active === status;

                    el.style.display = (matchesSearch && matchesFilter) ? '' : 'none';
                });
            }

            input.addEventListener('input', applyFilter);
            filters.forEach(btn=> btn.addEventListener('click', function(){
                filters.forEach(b=>b.classList.remove('active'));
                this.classList.add('active');
                applyFilter();
            }));
            // initial apply
            applyFilter();
        })();
    </script>

</div>