@model IEnumerable<EventFlow.Models.Event>

@{
    ViewData["Title"] = "Club Events";

    var manageableIds =
        ViewBag.ManageableEventIds as HashSet<int> ?? new HashSet<int>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Club Events</h1>
            <p class="text-muted mb-0">
                Manage events organized by your clubs.
            </p>
        </div>
    </div>

    <partial name="_Alerts" />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Your clubs have not organized any events yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Club</th>
                        <th>Date</th>
                        <th>Approval</th>
                        <th>Participants</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var eventItem in Model)
                    {
                        <tr>
                            <td>
                                <strong>@eventItem.Name</strong>
                            </td>

                            <td>
                                @(eventItem.Club?.Name
                                    ?? eventItem.ClubName
                                    ?? "Unknown")
                            </td>

                            <td>
                                @eventItem.StartDateTime.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (eventItem.ApprovalStatus == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (eventItem.ApprovalStatus == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                            </td>

                            <td>
                                @eventItem.Registrations.Count /
                                @eventItem.MaxParticipants
                            </td>

                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    @if (eventItem.ApprovalStatus == "Approved")
                                    {
                                        <a asp-controller="Events"
                                           asp-action="Details"
                                           asp-route-id="@eventItem.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>
                                    }

                                    @if (eventItem.ApprovalStatus == "Approved" &&
                                         manageableIds.Contains(eventItem.Id))
                                    {
                                        <a asp-controller="Volunteer"
                                           asp-action="EventVolunteers"
                                           asp-route-eventId="@eventItem.Id"
                                           class="btn btn-sm btn-outline-success">
                                            Volunteers
                                        </a>
                                    }

                                    @if (eventItem.ApprovalStatus != "Approved")
                                    {
                                        <a asp-action="EditEvent"
                                           asp-route-id="@eventItem.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>

                                        <form asp-action="DeleteEvent"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@eventItem.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>