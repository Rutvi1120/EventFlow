@{
    ViewData["Title"] = "Club President Dashboard";

    var presidentName =
        ViewBag.PresidentName?.ToString() ?? "President";

    var myClubCount =
        Convert.ToInt32(ViewBag.MyClubCount ?? 0);

    var clubEventCount =
        Convert.ToInt32(ViewBag.ClubEventCount ?? 0);

    var upcomingEventCount =
        Convert.ToInt32(ViewBag.UpcomingEventCount ?? 0);

    var completedEventCount =
        Convert.ToInt32(ViewBag.CompletedEventCount ?? 0);

    var totalParticipants =
        Convert.ToInt32(ViewBag.TotalParticipants ?? 0);

    var pendingVolunteerCount =
        Convert.ToInt32(ViewBag.PendingVolunteerCount ?? 0);

    var totalEventsForProgress =
        Math.Max(clubEventCount, 1);

    var upcomingPercent =
        Math.Min(
            100,
            (upcomingEventCount * 100) / totalEventsForProgress);

    var completedPercent =
        Math.Min(
            100,
            (completedEventCount * 100) / totalEventsForProgress);
}

<style>
    .club-president-dashboard {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* =========================================================
           WELCOME BANNER
           ========================================================= */

    .cp-welcome-banner {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 190px;
        padding: 38px 45px;
        margin-bottom: 28px;
        border-radius: 24px;
        background: linear-gradient( 135deg, #312e81 0%, #4338ca 55%, #5b21b6 100% );
        color: white;
        box-shadow: 0 15px 35px rgba(67, 56, 202, 0.20);
    }

        .cp-welcome-banner::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            right: 80px;
            top: -150px;
            border: 1px solid rgba(255, 255, 255, 0.13);
            border-radius: 50%;
        }

        .cp-welcome-banner::after {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            right: 125px;
            top: -105px;
            border: 1px solid rgba(255, 255, 255, 0.10);
            border-radius: 50%;
        }

    .cp-welcome-content {
        position: relative;
        z-index: 2;
    }

    .cp-welcome-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 1.6px;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.65);
        margin-bottom: 10px;
    }

    .cp-welcome-content h1 {
        font-size: 2.5rem;
        font-weight: 750;
        margin: 0 0 10px;
        color: white;
    }

    .cp-welcome-content p {
        margin: 0;
        color: rgba(255, 255, 255, 0.75);
        font-size: 0.98rem;
    }

    .cp-welcome-icon {
        position: relative;
        z-index: 2;
        width: 90px;
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.13);
        border: 1px solid rgba(255, 255, 255, 0.15);
        font-size: 2.4rem;
        backdrop-filter: blur(8px);
    }

    /* =========================================================
           ANALYTICS CARDS
           ========================================================= */

    .cp-analytics-card {
        position: relative;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 25px;
        min-height: 180px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .cp-analytics-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.07);
        }

        .cp-analytics-card::after {
            content: "";
            position: absolute;
            width: 110px;
            height: 110px;
            right: -40px;
            bottom: -45px;
            border-radius: 50%;
            background: #eef2ff;
        }

    .cp-analytics-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 1.35rem;
        margin-bottom: 18px;
    }

    .cp-clubs-card .cp-analytics-icon {
        background: #eef2ff;
    }

    .cp-events-card .cp-analytics-icon {
        background: #ede9fe;
    }

    .cp-participants-card .cp-analytics-icon {
        background: #ecfdf5;
    }

    .cp-upcoming-card .cp-analytics-icon {
        background: #eff6ff;
    }

    .cp-completed-card .cp-analytics-icon {
        background: #f0fdf4;
    }

    .cp-volunteer-card .cp-analytics-icon {
        background: #fff7ed;
    }

    .cp-analytics-title {
        position: relative;
        z-index: 2;
        color: #6b7280;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 7px;
    }

    .cp-analytics-number {
        position: relative;
        z-index: 2;
        color: #111827;
        font-size: 2.3rem;
        line-height: 1;
        font-weight: 750;
        margin-bottom: 9px;
    }

    .cp-analytics-subtitle {
        position: relative;
        z-index: 2;
        color: #9ca3af;
        font-size: 0.82rem;
    }

    /* =========================================================
           OVERVIEW SECTION
           ========================================================= */

    .cp-overview-section {
        margin-top: 28px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.035);
    }

    .cp-section-label {
        color: #6366f1;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.4px;
        margin-bottom: 5px;
    }

    .cp-section-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 5px;
    }

    .cp-section-description {
        color: #6b7280;
        font-size: 0.88rem;
        margin: 0 0 24px;
    }

    .cp-overview-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 0;
        border-bottom: 1px solid #f0f1f3;
    }

        .cp-overview-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .cp-overview-row:first-of-type {
            padding-top: 0;
        }

    .cp-overview-name {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #374151;
        font-size: 0.92rem;
        font-weight: 600;
    }

    .cp-overview-value {
        color: #4f46e5;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .cp-overview-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #6366f1;
    }

        .cp-overview-dot.green {
            background: #10b981;
        }

        .cp-overview-dot.orange {
            background: #f59e0b;
        }

        .cp-overview-dot.blue {
            background: #0ea5e9;
        }

    /* =========================================================
           EVENT ACTIVITY
           ========================================================= */

    .cp-activity-section {
        margin-top: 28px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.035);
    }

    .cp-progress-item {
        margin-bottom: 24px;
    }

        .cp-progress-item:last-child {
            margin-bottom: 0;
        }

    .cp-progress-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 9px;
        color: #374151;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .cp-progress-value {
        color: #4f46e5;
        font-weight: 700;
    }

    .cp-progress-track {
        height: 10px;
        overflow: hidden;
        border-radius: 999px;
        background: #eef2f7;
    }

    .cp-progress-bar {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient( 90deg, #4338ca, #6366f1 );
        transition: width 0.3s ease;
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 900px) {
        .cp-welcome-banner {
            padding: 32px 35px;
        }

        .cp-welcome-content h1 {
            font-size: 2.2rem;
        }

        .cp-welcome-icon {
            width: 75px;
            height: 75px;
            font-size: 2rem;
        }
    }

    @@media (max-width: 576px) {
        .club-president-dashboard {
            padding: 0 3px;
        }

        .cp-welcome-banner {
            padding: 28px 25px;
            min-height: 170px;
            border-radius: 20px;
        }

        .cp-welcome-content h1 {
            font-size: 1.8rem;
        }

        .cp-welcome-content p {
            font-size: 0.88rem;
        }

        .cp-welcome-icon {
            display: none;
        }

        .cp-analytics-card {
            min-height: 160px;
        }

        .cp-analytics-number {
            font-size: 2rem;
        }

        .cp-overview-section,
        .cp-activity-section {
            padding: 22px;
        }
    }
</style>

<div class="container py-4">

    <div class="club-president-dashboard">

        <partial name="_Alerts" />

        <!-- =====================================================
             WELCOME
             ====================================================== -->

        <div class="cp-welcome-banner">

            <div class="cp-welcome-content">

                <div class="cp-welcome-label">
                    CLUB PRESIDENT PORTAL
                </div>

                <h1>
                    Welcome back, @presidentName 👋
                </h1>

                <p>
                    Here's an overview of your clubs and their event activity.
                </p>

            </div>

            <div class="cp-welcome-icon">
                🏛️
            </div>

        </div>


        <!-- =====================================================
             ANALYTICS
             No navigation/action buttons here.
             ====================================================== -->

        <div class="row g-4">

            <!-- MY CLUBS -->

            <div class="col-md-6 col-xl-4">

                <div class="cp-analytics-card cp-clubs-card">

                    <div class="cp-analytics-icon">
                        🏛️
                    </div>

                    <div class="cp-analytics-title">
                        My Clubs
                    </div>

                    <div class="cp-analytics-number">
                        @myClubCount
                    </div>

                    <div class="cp-analytics-subtitle">
                        Approved clubs under your presidency
                    </div>

                </div>

            </div>


            <!-- CLUB EVENTS -->

            <div class="col-md-6 col-xl-4">

                <div class="cp-analytics-card cp-events-card">

                    <div class="cp-analytics-icon">
                        📅
                    </div>

                    <div class="cp-analytics-title">
                        Total Club Events
                    </div>

                    <div class="cp-analytics-number">
                        @clubEventCount
                    </div>

                    <div class="cp-analytics-subtitle">
                        Events organized by your clubs
                    </div>

                </div>

            </div>


            <!-- PARTICIPANTS -->

            <div class="col-md-6 col-xl-4">

                <div class="cp-analytics-card cp-participants-card">

                    <div class="cp-analytics-icon">
                        👥
                    </div>

                    <div class="cp-analytics-title">
                        Total Participants
                    </div>

                    <div class="cp-analytics-number">
                        @totalParticipants
                    </div>

                    <div class="cp-analytics-subtitle">
                        Registrations across your club events
                    </div>

                </div>

            </div>


            <!-- UPCOMING -->

            <div class="col-md-6 col-xl-4">

                <div class="cp-analytics-card cp-upcoming-card">

                    <div class="cp-analytics-icon">
                        🗓️
                    </div>

                    <div class="cp-analytics-title">
                        Upcoming Events
                    </div>

                    <div class="cp-analytics-number">
                        @upcomingEventCount
                    </div>

                    <div class="cp-analytics-subtitle">
                        Approved events scheduled ahead
                    </div>

                </div>

            </div>


            <!-- COMPLETED -->

            <div class="col-md-6 col-xl-4">

                <div class="cp-analytics-card cp-completed-card">

                    <div class="cp-analytics-icon">
                        ✓
                    </div>

                    <div class="cp-analytics-title">
                        Completed Events
                    </div>

                    <div class="cp-analytics-number">
                        @completedEventCount
                    </div>

                    <div class="cp-analytics-subtitle">
                        Events that have already finished
                    </div>

                </div>

            </div>


            <!-- PENDING VOLUNTEERS -->

            <div class="col-md-6 col-xl-4">

                <div class="cp-analytics-card cp-volunteer-card">

                    <div class="cp-analytics-icon">
                        ⏳
                    </div>

                    <div class="cp-analytics-title">
                        Pending Volunteers
                    </div>

                    <div class="cp-analytics-number">
                        @pendingVolunteerCount
                    </div>

                    <div class="cp-analytics-subtitle">
                        Applications awaiting action
                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             CLUB ACTIVITY OVERVIEW
             ====================================================== -->

        <div class="cp-overview-section">

            <div class="cp-section-label">
                CLUB OVERVIEW
            </div>

            <h2 class="cp-section-title">
                Your Club Activity
            </h2>

            <p class="cp-section-description">
                A quick summary of activity across the clubs you manage.
            </p>


            <div class="cp-overview-row">

                <div class="cp-overview-name">
                    <span class="cp-overview-dot"></span>
                    Approved clubs
                </div>

                <div class="cp-overview-value">
                    @myClubCount
                </div>

            </div>


            <div class="cp-overview-row">

                <div class="cp-overview-name">
                    <span class="cp-overview-dot blue"></span>
                    Total club events
                </div>

                <div class="cp-overview-value">
                    @clubEventCount
                </div>

            </div>


            <div class="cp-overview-row">

                <div class="cp-overview-name">
                    <span class="cp-overview-dot green"></span>
                    Total participants
                </div>

                <div class="cp-overview-value">
                    @totalParticipants
                </div>

            </div>


            <div class="cp-overview-row">

                <div class="cp-overview-name">
                    <span class="cp-overview-dot orange"></span>
                    Pending volunteer applications
                </div>

                <div class="cp-overview-value">
                    @pendingVolunteerCount
                </div>

            </div>

        </div>


        <!-- =====================================================
             EVENT ACTIVITY
             ====================================================== -->

        <div class="cp-activity-section">

            <div class="cp-section-label">
                EVENT ACTIVITY
            </div>

            <h2 class="cp-section-title">
                Event Progress
            </h2>

            <p class="cp-section-description">
                Overview of upcoming and completed events organized by your clubs.
            </p>


            <!-- UPCOMING -->

            <div class="cp-progress-item">

                <div class="cp-progress-header">

                    <span>
                        Upcoming Events
                    </span>

                    <span class="cp-progress-value">
                        @upcomingEventCount
                    </span>

                </div>

                <div class="cp-progress-track">

                    <div class="cp-progress-bar"
                         style="width: @upcomingPercent%;">
                    </div>

                </div>

            </div>


            <!-- COMPLETED -->

            <div class="cp-progress-item">

                <div class="cp-progress-header">

                    <span>
                        Completed Events
                    </span>

                    <span class="cp-progress-value">
                        @completedEventCount
                    </span>

                </div>

                <div class="cp-progress-track">

                    <div class="cp-progress-bar"
                         style="width: @completedPercent%;">
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>