@model EventFlow.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Events
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <span class="badge bg-primary mb-2">
                        @Model.EventType
                    </span>

                    <h1 class="mb-2">@Model.Name</h1>

                    @if (Model.Club != null)
                    {
                        <p class="text-muted mb-0">
                            Club: @Model.Club.Name
                        </p>
                    }
                </div>

                <span class="badge bg-success">
                    @Model.Status
                </span>
            </div>

            <hr />

            <div class="mb-4">
                <h5>Description</h5>
                <p class="mb-0">@Model.Description</p>
            </div>

            <div class="row g-3 mb-4">

                <div class="col-md-6">
                    <strong>Start</strong>
                    <div>
                        @Model.StartDateTime.ToString("dd MMM yyyy hh:mm tt")
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>End</strong>
                    <div>
                        @Model.EndDateTime.ToString("dd MMM yyyy hh:mm tt")
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Venue</strong>
                    <div>
                        @(Model.Venue?.Name ?? "Not specified")
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Maximum Participants</strong>
                    <div>
                        @Model.MaxParticipants
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Organizer</strong>
                    <div>
                        @(Model.Organizer?.FullName ?? "Not specified")
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Approval</strong>
                    <div>
                        @Model.ApprovalStatus
                    </div>
                </div>

            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex flex-wrap gap-2">

                    <form asp-controller="Registration"
                          asp-action="Register"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="eventId"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-primary">
                            Register
                        </button>

                    </form>

                    <a asp-controller="Volunteer"
                       asp-action="Apply"
                       asp-route-eventId="@Model.Id"
                       class="btn btn-outline-primary">
                        Volunteer
                    </a>

                </div>
            }
            else
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="btn btn-primary">
                    Login to Register
                </a>
            }

        </div>
    </div>
</div>