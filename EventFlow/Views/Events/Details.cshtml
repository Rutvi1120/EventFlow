@model EventFlow.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<h1>Event Details</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">
        @TempData["Message"]
    </div>
}

<div>
    <h4>@Model.Name</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>


        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>


        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StartDateTime)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StartDateTime)
        </dd>


        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EndDateTime)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EndDateTime)
        </dd>


        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MaxParticipants)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaxParticipants)
        </dd>


        <dt class="col-sm-2">
            Registered
        </dt>

        <dd class="col-sm-10">
            @ViewBag.RegisteredCount / @Model.MaxParticipants
        </dd>


        <dt class="col-sm-2">
            Available Seats
        </dt>

        <dd class="col-sm-10">

            @if (ViewBag.AvailableSeats > 0)
            {
                <span class="text-success">
                    @ViewBag.AvailableSeats seats available
                </span>
            }
            else
            {
                <span class="text-danger">
                    Event Full
                </span>
            }

        </dd>


        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>


        <dt class="col-sm-2">
            Venue
        </dt>

        <dd class="col-sm-10">

            @if (Model.Venue != null)
            {
                @Model.Venue.Name
            }
            else
            {
                <span class="text-muted">
                    No venue assigned
                </span>
            }

        </dd>

    </dl>
</div>

<hr />


@* ================= PARTICIPANT ACTIONS ================= *@

@if (User.IsInRole("Participant"))
{
    <div class="mt-3">

        @* Already Registered *@
        @if (ViewBag.AlreadyRegistered == true)
        {
            <div class="alert alert-success">
                You are already registered for this event.
            </div>

            <form asp-controller="Registration"
                  asp-action="CancelRegistration"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="eventId"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Cancel Registration
                </button>

            </form>
        }

        @* Already Waitlisted *@
        else if (ViewBag.AlreadyWaitlisted == true)
        {
            <div class="alert alert-warning">
                You are already on the waitlist for this event.
            </div>

            <form asp-controller="Registration"
                  asp-action="LeaveWaitlist"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="eventId"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-warning">
                    Leave Waitlist
                </button>

            </form>
        }

        @* Event Already Started *@
        else if (Model.StartDateTime <= DateTime.Now)
        {
            <div class="alert alert-warning">
                This event has already started. Registration is closed.
            </div>
        }

        @* Event Is Full *@
        else if (ViewBag.AvailableSeats <= 0)
        {
            <div class="alert alert-warning">
                This event is currently full.
            </div>

            <form asp-controller="Registration"
                  asp-action="Register"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="eventId"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-warning">
                    Join Waitlist
                </button>

            </form>
        }

        @* Seats Available *@
        else
        {
            <form asp-controller="Registration"
                  asp-action="Register"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="eventId"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-primary">
                    Register for Event
                </button>

            </form>
        }

    </div>
}


@* ================= PAGE ACTIONS ================= *@

<div class="mt-3">

    @if (User.IsInRole("Organizer") || User.IsInRole("Admin"))
    {
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Edit
        </a>
    }

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Events
    </a>

</div>