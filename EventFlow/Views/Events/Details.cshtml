@model EventFlow.Models.Event

@{
    ViewData["Title"] = "Event Details";

    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool isStudent = User.IsInRole("Student");

    bool isRegistered = ViewBag.IsRegistered == true;
    bool isWaitlisted = ViewBag.IsWaitlisted == true;
    bool isActiveVolunteer = ViewBag.IsActiveVolunteer == true;
    int registeredCount = ViewBag.RegisteredCount ?? 0;
    int waitlistCount = ViewBag.WaitlistCount ?? 0;
    int seatsLeft = ViewBag.SeatsLeft ?? 0;

    bool isOrganizer = ViewBag.IsOrganizer == true;

    string? myVolunteerStatus =
        ViewBag.MyVolunteerStatus as string;
        bool isFull = seatsLeft <= 0;
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Events
        </a>
    </div>

    <partial name="_Alerts" />

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <span class="badge bg-primary mb-2">@Model.EventType</span>

                    <h1 class="mb-2">@Model.Name</h1>

                    @if (Model.Club != null)
                    {
                        <p class="text-muted mb-0">Club: @Model.Club.Name</p>
                    }
                </div>

                <partial name="_EventStatusBadge" model="Model" />
            </div>

            <hr />

            @if (!string.IsNullOrEmpty(Model.BannerImagePath))
            {
                <div class="mb-3">
       
                    <img src="@Url.Content(Model.BannerImagePath)"
                         alt="Event Banner"
                         class="img-fluid rounded"
                         style="max-height: 200px; cursor: zoom-in;"
                         onclick="openBannerFullscreen(this.src)" />
                </div>
            }

            <!-- Full-screen image viewer -->
            <div id="bannerViewer"
                 onclick="closeBannerFullscreen()"
                 style="display:none;
                        position:fixed;
                        z-index:9999;
                        inset:0;
                        background:rgba(0,0,0,0.95);
                        align-items:center;
                        justify-content:center;
                        padding:20px;">

                <button type="button"
                        onclick="closeBannerFullscreen(); event.stopPropagation();"
                        aria-label="Close image"
                        style="position:absolute;
                               top:20px;
                               right:25px;
                               color:white;
                               background:transparent;
                               border:none;
                               font-size:35px;
                               cursor:pointer;">
                    &times;
                </button>

                <img id="fullscreenBanner"
                     alt="Full-screen Event Banner"
                     style="max-width:95%;
                            max-height:90vh;
                            object-fit:contain;"
                     onclick="event.stopPropagation()" />
            </div>

            <script>
                function openBannerFullscreen(imageSrc) {
                    document.getElementById('fullscreenBanner').src = imageSrc;

                    const viewer = document.getElementById('bannerViewer');
                    viewer.style.display = 'flex';

                    document.body.style.overflow = 'hidden';
                }

                function closeBannerFullscreen() {
                    document.getElementById('bannerViewer').style.display = 'none';
                    document.body.style.overflow = '';
                }

                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape') {
                        closeBannerFullscreen();
                    }
                });
            </script>



            <div class="mb-4">
                <h5>Description</h5>
                <p class="mb-0">@Model.Description</p>
            </div>

            <div class="row g-3 mb-4">

                <div class="col-md-6">
                    <strong>Start</strong>
                    <div>@Model.StartDateTime.ToString("dd MMM yyyy hh:mm tt")</div>
                </div>

                <div class="col-md-6">
                    <strong>End</strong>
                    <div>@Model.EndDateTime.ToString("dd MMM yyyy hh:mm tt")</div>
                </div>

                <div class="col-md-6">
                    <strong>Venue</strong>
                    <div>@(Model.Venue?.Name ?? "Not specified")</div>
                </div>

                <div class="col-md-6">
                    <strong>Seats</strong>
                    <div>
                        @registeredCount / @Model.MaxParticipants registered
                        @if (!Model.HasStarted)
                        {
                            if (isFull)
                            {
                                <span class="badge bg-danger ms-1">Full</span>
                            }
                            else
                            {
                                <span class="badge bg-success ms-1">@seatsLeft left</span>
                            }
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Organizer</strong>
                    <div>@(Model.Organizer?.FullName ?? "Not specified")</div>
                </div>

                <div class="col-md-6">
                    <strong>Approval</strong>
                    <div>@Model.ApprovalStatus</div>
                </div>

            </div>

            @if (!isAuthenticated)
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="btn btn-primary">
                    Login to Register
                </a>
            }
            else if (isOrganizer)
            {
                <!-- Organizer dashboard for this event -->
                <div class="mb-3">
                    <h4>Organizer Dashboard</h4>

                    <div class="row g-3">
                        <div class="col-auto">
                            <div class="card p-3">
                                <div class="fs-5 fw-bold">Participants</div>
                                <div class="text-muted">@registeredCount total</div>
                            </div>
                        </div>

                        <div class="col-auto">
                            <div class="card p-3">
                                <div class="fs-5 fw-bold">Volunteers</div>
                                <div class="text-muted">@Model.Volunteers.Count total</div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 d-flex gap-2 flex-wrap">
                        <a asp-controller="Events" asp-action="Participants" asp-route-id="@Model.Id" class="btn btn-outline-primary">View Participants</a>
                        <a asp-controller="Volunteer" asp-action="EventVolunteers" asp-route-eventId="@Model.Id" class="btn btn-outline-secondary">Manage Volunteers</a>
                        <a asp-controller="Events" asp-action="ExportParticipants" asp-route-id="@Model.Id" class="btn btn-outline-success">Download Participants CSV</a>
                        <a asp-controller="Events" asp-action="ExportVolunteers" asp-route-id="@Model.Id" class="btn btn-outline-info">Download Volunteers CSV</a>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex flex-wrap align-items-center gap-2">

                    @* ---------- REGISTRATION ---------- *@
                    @if (Model.HasEnded)
                    {
                        <span class="badge bg-secondary fs-6">This event has ended</span>
                    }
                    else if (isActiveVolunteer)
                    {
                        <span class="badge bg-info text-dark fs-6">You are registered as a volunteer</span>
                        <span class="text-muted">Volunteer and participant registration cannot be combined for the same event.</span>
                    }
                    else if (isRegistered)
                    {
                        <span class="badge bg-success fs-6">You are registered</span>

                        <form asp-controller="Registration"
                              asp-action="Cancel"
                              method="post"
                              onsubmit="return confirm('Cancel your registration?');">
                            <input type="hidden" name="eventId" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-danger">
                                Cancel Registration
                            </button>
                        </form>
                    }
                    else if (isWaitlisted)
                    {
                        <span class="badge bg-warning text-dark fs-6">You are on the waitlist</span>

                        <form asp-controller="Registration"
                              asp-action="LeaveWaitlist"
                              method="post">
                            <input type="hidden" name="eventId" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-danger">
                                Leave Waitlist
                            </button>
                        </form>
                    }
                    else if (Model.HasStarted)
                    {
                        <span class="badge bg-info text-dark fs-6">
                            Registration closed - event in progress
                        </span>
                    }
                    else if (isOrganizer)
                    {
                        <span class="badge bg-secondary fs-6">You are the organizer of this event</span>
                    }
                    else if (isFull)
                    {
                        <form asp-controller="Registration"
                              asp-action="JoinWaitlist"
                              method="post">
                            <input type="hidden" name="eventId" value="@Model.Id" />
                            <button type="submit" class="btn btn-warning">
                                Event Full - Join Waitlist
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Registration"
                              asp-action="Register"
                              method="post">
                            <input type="hidden" name="eventId" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary">
                                Register
                            </button>
                        </form>
                    }

                    @* ---------- VOLUNTEERING (students only) ---------- *@
                    @if (isStudent)
                    {
                        if (myVolunteerStatus != null)
                        {
                            <a asp-controller="Volunteer"
                               asp-action="MyApplications"
                               class="btn btn-outline-secondary">
                                Volunteer application: @myVolunteerStatus
                            </a>
                        }
                        else if (!Model.HasEnded && !isRegistered)
                        {
                            <a asp-controller="Volunteer"
                               asp-action="Apply"
                               asp-route-eventId="@Model.Id"
                               class="btn btn-outline-success">
                                Apply as Volunteer
                            </a>
                        }
                    }

                </div>
            }

        </div>
    </div>
</div>
