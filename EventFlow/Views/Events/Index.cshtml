@model IEnumerable<EventFlow.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<h1>Events</h1>

@if (User.IsInRole("Admin") || User.IsInRole("Organizer"))
{
    <p>
        <a asp-action="Create" class="btn btn-success">
            Create New Event
        </a>
    </p>
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">
        @TempData["Message"]
    </div>
}

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>

            <th>
                Start
            </th>

            <th>
                End
            </th>

            <th>
                @Html.DisplayNameFor(model => model.MaxParticipants)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>

            <th>
                Venue
            </th>

            <th>
                Actions
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>

                <td>
                    @item.StartDateTime.ToString("dd MMM yyyy, hh:mm tt")
                </td>

                <td>
                    @item.EndDateTime.ToString("dd MMM yyyy, hh:mm tt")
                </td>

                <td>
                    @item.MaxParticipants
                </td>

                <td>
                    @if (item.Status == "Upcoming")
                    {
                        <span class="badge bg-success">
                            Upcoming
                        </span>
                    }
                    else if (item.Status == "Ongoing")
                    {
                        <span class="badge bg-primary">
                            Ongoing
                        </span>
                    }
                    else if (item.Status == "Delayed")
                    {
                        <span class="badge bg-warning text-dark">
                            Delayed
                        </span>
                    }
                    else if (item.Status == "Completed")
                    {
                        <span class="badge bg-secondary">
                            Completed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-info">
                            @item.Status
                        </span>
                    }
                </td>

                <td>
                    @if (item.Venue != null)
                    {
                        @item.Venue.Name
                    }
                    else
                    {
                        <span>No venue</span>
                    }
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-primary">
                        Details
                    </a>

                    @if (User.IsInRole("Admin") ||
                         User.IsInRole("Organizer"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">

    @if (User.IsInRole("Participant"))
    {
        <a asp-controller="Participant"
           asp-action="Dashboard"
           class="btn btn-secondary">
            ← Back to Participant Dashboard
        </a>
    }
    else if (User.IsInRole("Organizer"))
    {
        <a asp-controller="Organizer"
           asp-action="Dashboard"
           class="btn btn-secondary">
            ← Back to Organizer Dashboard
        </a>
    }
    else if (User.IsInRole("Admin"))
    {
        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn btn-secondary">
            ← Back to Admin Dashboard
        </a>
    }
</div>