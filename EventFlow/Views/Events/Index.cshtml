@model IEnumerable<EventFlow.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Events</h1>
        <p class="text-muted">
            Browse approved college events.
        </p>
    </div>

    <partial name="_Alerts" />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No approved events are currently available.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var eventItem in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-primary">
                                    @eventItem.EventType
                                </span>

                                <partial name="_EventStatusBadge" model="eventItem" />
                            </div>

                            <h4 class="card-title">
                                @eventItem.Name
                            </h4>

                            <p class="text-muted">
                                @eventItem.Description
                            </p>

                            <div class="mb-2">
                                <strong>Date:</strong>
                                @eventItem.StartDateTime.ToString("dd MMM yyyy")
                            </div>

                            <div class="mb-2">
                                <strong>Time:</strong>
                                @eventItem.StartDateTime.ToString("hh:mm tt")
                                -
                                @eventItem.EndDateTime.ToString("hh:mm tt")
                            </div>

                            <div class="mb-3">
                                <strong>Venue:</strong>
                                @(eventItem.Venue?.Name ?? "Not specified")
                            </div>

                            <div class="mt-auto">
                                <a asp-action="Details"
                                   asp-route-id="@eventItem.Id"
                                   class="btn btn-primary w-100">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>