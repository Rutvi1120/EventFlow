@model IEnumerable<EventFlow.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Events</h1>
        <p class="text-muted">
            Browse approved college events.
        </p>
    </div>

    <div class="mb-3 d-flex gap-2 align-items-center">
        <input id="events-search" class="form-control" style="max-width:360px;" type="search" placeholder="Search events..." />

        <div class="btn-group" role="group" aria-label="Filter events">
            <button type="button" class="btn btn-outline-secondary btn-sm events-filter active" data-filter="all">All</button>
            <button type="button" class="btn btn-outline-secondary btn-sm events-filter" data-filter="upcoming">Upcoming</button>
            <button type="button" class="btn btn-outline-secondary btn-sm events-filter" data-filter="ongoing">Ongoing</button>
            <button type="button" class="btn btn-outline-secondary btn-sm events-filter" data-filter="completed">Completed</button>
        </div>
    </div>

    <partial name="_Alerts" />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No approved events are currently available.
        </div>
    }
    else
    {
        <div class="row g-4" id="events-list">
            @foreach (var eventItem in Model)
            {
                var startIso = eventItem.StartDateTime.ToString("O");
                var endIso = eventItem.EndDateTime.ToString("O");
                <div class="col-md-6 col-lg-4 event-card" data-name="@eventItem.Name.ToLower()" data-start="@startIso" data-end="@endIso">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-primary">
                                    @eventItem.EventType
                                </span>

                                <partial name="_EventStatusBadge" model="eventItem" />
                            </div>

                            <h4 class="card-title">
                                @eventItem.Name
                            </h4>

                            <p class="text-muted">
                                @eventItem.Description
                            </p>

                            <div class="mb-2">
                                <strong>Date:</strong>
                                @eventItem.StartDateTime.ToString("dd MMM yyyy")
                            </div>

                            <div class="mb-2">
                                <strong>Time:</strong>
                                @eventItem.StartDateTime.ToString("hh:mm tt")
                                -
                                @eventItem.EndDateTime.ToString("hh:mm tt")
                            </div>

                            <div class="mb-3">
                                <strong>Venue:</strong>
                                @(eventItem.Venue?.Name ?? "Not specified")
                            </div>
                           @if (!string.IsNullOrWhiteSpace(eventItem.BannerImagePath))
{
    <img src="@Url.Content(eventItem.BannerImagePath)"
         class="card-img-top"
         alt="@eventItem.Name banner"
         style="height: 220px; width: 100%; object-fit: cover;"
         onerror="this.style.display='none';" />
}
else
{
    <div class="text-muted text-center py-4">
        No banner available
    </div>
}

                            <div class="mt-auto">
                                <a asp-action="Details"
                                   asp-route-id="@eventItem.Id"
                                   class="btn btn-primary w-100">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <script>
        (function(){
            const input = document.getElementById('events-search');
            const filters = document.querySelectorAll('.events-filter');

            function computeStatus(start, end){
                const now = new Date();
                if (now < start) return 'upcoming';
                if (now >= start && now <= end) return 'ongoing';
                return 'completed';
            }

            function applyFilter(){
                const q = input.value.trim().toLowerCase();
                const active = document.querySelector('.events-filter.active')?.dataset.filter || 'all';
                document.querySelectorAll('.event-card').forEach(el=>{
                    const name = (el.dataset.name || '').toLowerCase();
                    const start = new Date(el.dataset.start);
                    const end = new Date(el.dataset.end);
                    const status = computeStatus(start,end);

                    const matchesSearch = q === '' || name.indexOf(q) !== -1;
                    const matchesFilter = active === 'all' || active === status;

                    el.style.display = (matchesSearch && matchesFilter) ? '' : 'none';
                });
            }

            input.addEventListener('input', applyFilter);
            filters.forEach(btn=> btn.addEventListener('click', function(){
                filters.forEach(b=>b.classList.remove('active'));
                this.classList.add('active');
                applyFilter();
            }));
        })();
    </script>
    <script>
        // ensure filtering runs on initial load
        document.addEventListener('DOMContentLoaded', function(){
            const evt = new Event('input');
            const el = document.getElementById('events-search');
            if (el) el.dispatchEvent(evt);
        });
    </script>
</div>