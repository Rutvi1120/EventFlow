@model IEnumerable<EventFlow.Models.Event>

@{
    ViewData["Title"] = "My Events";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>My Events</h1>
            <p class="text-muted mb-0">
                Events you have organized.
            </p>
        </div>
    </div>

    <div class="mb-3 d-flex gap-2 align-items-center">
        <input id="myevents-search" class="form-control" style="max-width:360px;" type="search" placeholder="Search events..." />

        <div class="btn-group" role="group" aria-label="Filter events">
            <button type="button" class="btn btn-outline-secondary btn-sm myevents-filter active" data-filter="all">All</button>
            <button type="button" class="btn btn-outline-secondary btn-sm myevents-filter" data-filter="upcoming">Upcoming</button>
            <button type="button" class="btn btn-outline-secondary btn-sm myevents-filter" data-filter="ongoing">Ongoing</button>
            <button type="button" class="btn btn-outline-secondary btn-sm myevents-filter" data-filter="completed">Completed</button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have not organized any events yet.
        </div>
    }
    else
    {
        <div class="table-responsive" id="myevents-list">
            <table class="table table-bordered table-hover align-middle">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Venue</th>
                        <th>Approval</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var eventItem in Model)
                    {
                        var startIso = eventItem.StartDateTime.ToString("o");
                        var endIso = eventItem.EndDateTime.ToString("o");

                        <tr class="event-row" data-name="@(eventItem.Name?.ToLower())" data-start="@startIso" data-end="@endIso">
                            <td>@eventItem.Name</td>

                            <td>
                                @eventItem.EventType
                            </td>

                            <td>
                                @eventItem.StartDateTime.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @(eventItem.Venue?.Name ?? "Not specified")
                            </td>

                            <td>
                                @eventItem.ApprovalStatus
                            </td>

                            <td>
                                @eventItem.Status
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@eventItem.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>