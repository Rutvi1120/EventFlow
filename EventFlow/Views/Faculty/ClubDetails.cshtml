@model EventFlow.Models.Club

@{
    ViewData["Title"] = Model.Name;
    var presidentRequests =
        ViewBag.PresidentRequests as IEnumerable<EventFlow.Models.ApplicationUser>
        ?? Enumerable.Empty<EventFlow.Models.ApplicationUser>();
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="AllClubs"
           class="text-decoration-none">
            ← Back to My Clubs
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="mb-3">
                        @if (Model.Status == "Approved")
                        {
                            <span class="badge bg-success">
                                Approved
                            </span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="badge bg-danger">
                                Rejected
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Pending Approval
                            </span>
                        }
                    </div>

                    <h1>@Model.Name</h1>

                    <p class="text-muted">
                        @(Model.Description ?? "No description available.")
                    </p>

                    <hr />

                    <div class="mb-3">
                        <strong>Department</strong>
                        <div>
                            @(Model.Department ?? "Not specified")
                        </div>
                    </div>

                    <div class="mb-3">
                        <strong>Club President</strong>
                        <div>
                            @(Model.ClubPresident?.FullName ?? "Not assigned")
                        </div>
                    </div>

                    <div>
                        <strong>Faculty Supervisor</strong>
                        <div>
                            @(Model.FacultySupervisor?.FullName ?? "Not assigned")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h3>Club President Requests</h3>

                    <p class="text-muted">
                        Approved Club President accounts waiting
                        for your approval.
                    </p>

                    @if (!presidentRequests.Any())
                    {
                        <div class="alert alert-info mb-0">
                            There are no pending club president requests.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Department</th>
                                        <th></th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var user in presidentRequests)
                                    {
                                        <tr>
                                            <td>
                                                <strong>
                                                    @user.FullName
                                                </strong>
                                            </td>

                                            <td>
                                                @user.Email
                                            </td>

                                            <td>
                                                @(user.Department ?? "Not specified")
                                            </td>

                                            <td>
                                                <div class="d-flex gap-2">
                                                    <form asp-action="ApprovePresident"
                                                          method="post">
                                                        <input type="hidden"
                                                               name="userId"
                                                               value="@user.Id" />

                                                        <button type="submit"
                                                                class="btn btn-sm btn-success">
                                                            Approve
                                                        </button>
                                                    </form>

                                                    <form asp-action="RejectPresident"
                                                          method="post">
                                                        <input type="hidden"
                                                               name="userId"
                                                               value="@user.Id" />

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger">
                                                            Reject
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h3 class="mb-1">Club Events</h3>
                            <p class="text-muted mb-0">
                                Events organized by this club.
                            </p>
                        </div>
                    </div>

                    @if (!Model.Events.Any())
                    {
                        <div class="alert alert-info">
                            This club has not organized any events yet.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Event</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var eventItem in Model.Events)
                                    {
                                        <tr>
                                            <td>
                                                <strong>
                                                    @eventItem.Name
                                                </strong>
                                            </td>

                                            <td>
                                                @eventItem.StartDateTime.ToString("dd MMM yyyy")
                                            </td>

                                            <td>
                                                @if (eventItem.ApprovalStatus == "Approved")
                                                {
                                                    <span class="badge bg-success">
                                                        Approved
                                                    </span>
                                                }
                                                else if (eventItem.ApprovalStatus == "Rejected")
                                                {
                                                    <span class="badge bg-danger">
                                                        Rejected
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        Pending
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                @if (eventItem.ApprovalStatus == "Approved")
                                                {
                                                    <a asp-controller="Events"
                                                       asp-action="Details"
                                                       asp-route-id="@eventItem.Id"
                                                       class="btn btn-sm btn-outline-primary">
                                                        Details
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll("form").forEach(function(form) {
            form.addEventListener("submit", function() {
                const button = form.querySelector("button[type='submit']");

                if (button) {
                    button.disabled = true;
                }
            });
        });
    </script>
}