@model EventFlow.Models.Event

@{
    ViewData["Title"] = "Create College Event";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Create College Event</h1>
        <p class="text-muted">
            Create an event for the college community.
        </p>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="CreateEvent"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name"
                                   class="form-label">
                                Event Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter event name" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Describe the event"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartDateTime"
                                       class="form-label">
                                    Start Date & Time
                                </label>

                                <input asp-for="StartDateTime"
                                       type="datetime-local"
                                       class="form-control"
                                       value="@(Model.StartDateTime == DateTime.MinValue
                                           ? DateTime.Now.ToString("yyyy-MM-ddTHH:mm")
                                           : Model.StartDateTime.ToString("yyyy-MM-ddTHH:mm"))" />

                                <span asp-validation-for="StartDateTime"
                                      class="text-danger">
                                </span>

                                <span asp-validation-for="StartDateTime"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="EndDateTime"
                                       class="form-label">
                                    End Date & Time
                                </label>

                                <input asp-for="EndDateTime"
                                       type="datetime-local"
                                       class="form-control"
                                       value="@(Model.EndDateTime == DateTime.MinValue
                                           ? DateTime.Now.AddHours(1).ToString("yyyy-MM-ddTHH:mm")
                                           : Model.EndDateTime.ToString("yyyy-MM-ddTHH:mm"))" />

                                <span asp-validation-for="EndDateTime"
                                      class="text-danger">
                                </span>

                                <span asp-validation-for="EndDateTime"
                                      class="text-danger">
                                </span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxParticipants"
                                       class="form-label">
                                    Maximum Participants
                                </label>

                                <input asp-for="MaxParticipants"
                                       type="number"
                                       min="1"
                                       class="form-control"
                                       placeholder="Enter participant limit" />

                                <span asp-validation-for="MaxParticipants"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="VenueId"
                                       class="form-label">
                                    Venue
                                </label>

                                <select asp-for="VenueId"
                                        asp-items="ViewBag.Venues"
                                        class="form-select">
                                    <option value="">
                                        Select Venue
                                    </option>
                                </select>

                                <span asp-validation-for="VenueId"
                                      class="text-danger">
                                </span>
                            </div>
                            <div class="mb-3">
                                <label for="bannerImage" class="form-label">
                                    Event Banner
                                </label>

                                <input type="file"
                                       id="bannerImage"
                                       name="bannerImage"
                                       class="form-control"
                                       accept=".jpg,.jpeg,.png,.webp" />

                                <div class="form-text">
                                    JPG, JPEG, PNG or WEBP. Maximum size: 5 MB.
                                </div>

                                <span class="text-danger"
                                      asp-validation-for="BannerImagePath"></span>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            College events created by Faculty are
                            automatically approved.
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                Create College Event
                            </button>

                            <a asp-action="Events"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}