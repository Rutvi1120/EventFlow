@{
    ViewData["Name"] = "Faculty Dashboard";

    var supervisedClubs =
        ViewBag.SupervisedClubs as IEnumerable<EventFlow.Models.Club>
        ?? Enumerable.Empty<EventFlow.Models.Club>();

    var pendingEvents =
        ViewBag.PendingEvents as IEnumerable<EventFlow.Models.Event>
        ?? Enumerable.Empty<EventFlow.Models.Event>();

    var myEvents =
        ViewBag.MyEvents as IEnumerable<EventFlow.Models.Event>
        ?? Enumerable.Empty<EventFlow.Models.Event>();

    var pendingVolunteerApplications =
        ViewBag.PendingVolunteerApplications as IEnumerable<EventFlow.Models.Volunteer>
        ?? Enumerable.Empty<EventFlow.Models.Volunteer>();

    int pendingVolunteerCount = ViewBag.PendingVolunteerCount ?? 0;

    var pendingPresidentRequests =
        ViewBag.PendingPresidentRequests as IEnumerable<dynamic>
        ?? Enumerable.Empty<dynamic>();
}

<style>
    .faculty-dashboard {
        max-width: 1500px;
        margin: 0 auto;
    }

    .faculty-welcome {
        background: linear-gradient(135deg, #312e81, #4338ca, #5b21b6);
        color: white;
        border-radius: 20px;
        padding: 30px;
        margin-bottom: 25px;
        box-shadow: 0 12px 30px rgba(49, 46, 129, 0.18);
    }

        .faculty-welcome h1 {
            margin: 0;
            font-size: 2rem;
            font-weight: 700;
        }

        .faculty-welcome p {
            margin: 8px 0 0;
            opacity: 0.82;
        }

    .faculty-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 28px;
    }

    .faculty-stat-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 22px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
    }

    .faculty-stat-label {
        color: #6b7280;
        font-size: 0.85rem;
        margin-bottom: 8px;
    }

    .faculty-stat-value {
        color: #111827;
        font-size: 1.9rem;
        font-weight: 700;
    }

    .faculty-section {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.05);
    }

    .faculty-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 18px;
    }

    .faculty-section-title {
        margin: 0;
        font-size: 1.2rem;
        font-weight: 700;
        color: #111827;
    }

    .faculty-section-subtitle {
        margin: 4px 0 0;
        color: #6b7280;
        font-size: 0.86rem;
    }

    .faculty-table {
        width: 100%;
        border-collapse: collapse;
    }

        .faculty-table th {
            padding: 12px;
            text-align: left;
            font-size: 0.8rem;
            color: #6b7280;
            background: #f9fafb;
            border-bottom: 1px solid #e5e7eb;
        }

        .faculty-table td {
            padding: 14px 12px;
            border-bottom: 1px solid #f1f5f9;
            color: #374151;
            font-size: 0.9rem;
            vertical-align: middle;
        }

        .faculty-table tr:last-child td {
            border-bottom: none;
        }

    .faculty-empty {
        text-align: center;
        padding: 30px 15px;
        color: #6b7280;
    }

    .faculty-status {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .faculty-status-pending {
        color: #92400e;
        background: #fef3c7;
    }

    .faculty-status-approved {
        color: #166534;
        background: #dcfce7;
    }

    .faculty-action-group {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .faculty-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 12px;
        border-radius: 8px;
        border: none;
        text-decoration: none;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
    }

    .faculty-action-primary {
        background: #4338ca;
        color: white;
    }

        .faculty-action-primary:hover {
            background: #3730a3;
            color: white;
        }

    .faculty-action-success {
        background: #dcfce7;
        color: #166534;
    }

        .faculty-action-success:hover {
            background: #bbf7d0;
            color: #14532d;
        }

    .faculty-action-danger {
        background: #fee2e2;
        color: #991b1b;
    }

        .faculty-action-danger:hover {
            background: #fecaca;
            color: #7f1d1d;
        }

    .faculty-club-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .faculty-club-card {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 18px;
        background: #fafafa;
    }

    .faculty-club-name {
        font-size: 1rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 6px;
    }

    .faculty-club-detail {
        color: #6b7280;
        font-size: 0.82rem;
        margin-bottom: 4px;
    }

    .faculty-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .faculty-summary-card {
        padding: 18px;
        border-radius: 14px;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
    }

    .faculty-summary-number {
        font-size: 1.7rem;
        font-weight: 700;
        color: #312e81;
    }

    .faculty-summary-label {
        margin-top: 4px;
        font-size: 0.82rem;
        color: #6b7280;
    }

    @@media (max-width: 1100px) {
        .faculty-stat-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .faculty-club-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 700px) {
        .faculty-stat-grid,
        .faculty-club-grid,
        .faculty-summary-grid {
            grid-template-columns: 1fr;
        }

        .faculty-welcome {
            padding: 22px;
        }

            .faculty-welcome h1 {
                font-size: 1.5rem;
            }

        .faculty-section {
            padding: 18px;
            overflow-x: auto;
        }

        .faculty-table {
            min-width: 700px;
        }
    }
</style>

<div class="faculty-dashboard">

    <div class="faculty-welcome">

        <h1>
            Faculty Dashboard 👨‍🏫
        </h1>

        <p>
            Manage event approvals, supervised clubs, volunteers,
            and your events from one place.
        </p>

    </div>


    <!-- =========================================================
         STATISTICS
         ========================================================= -->

    <div class="faculty-stat-grid">

        <div class="faculty-stat-card">

            <div class="faculty-stat-label">
                Pending Event Approvals
            </div>

            <div class="faculty-stat-value">
                @pendingEvents.Count()
            </div>

        </div>


        <div class="faculty-stat-card">

            <div class="faculty-stat-label">
                Pending Volunteers
            </div>

            <div class="faculty-stat-value">
                @pendingVolunteerCount
            </div>

        </div>


        <div class="faculty-stat-card">

            <div class="faculty-stat-label">
                Supervised Clubs
            </div>

            <div class="faculty-stat-value">
                @supervisedClubs.Count()
            </div>

        </div>


        <div class="faculty-stat-card">

            <div class="faculty-stat-label">
                My Events
            </div>

            <div class="faculty-stat-value">
                @myEvents.Count()
            </div>

        </div>

    </div>


    <!-- =========================================================
         PENDING EVENT APPROVALS
         ========================================================= -->

    <div class="faculty-section">

        <div class="faculty-section-header">

            <div>
                <h2 class="faculty-section-title">
                    Pending Event Approvals
                </h2>

                <p class="faculty-section-subtitle">
                    Review events waiting for your approval.
                </p>
            </div>

            @if (pendingEvents.Any())
            {
                <span class="faculty-status faculty-status-pending">
                    @pendingEvents.Count() Pending
                </span>
            }

        </div>


        @if (pendingEvents.Any())
        {
            <div class="table-responsive">

                <table class="faculty-table">

                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Organizer</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var eventItem in pendingEvents)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @eventItem.Name
                                    </strong>
                                </td>

                                <td>
                                    @eventItem.Organizer?.UserName
                                </td>

                                <td>
                                    @eventItem.StartDateTime.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @eventItem.EventType
                                </td>

                                <td>

                                    <div class="faculty-action-group">

                                        <form asp-controller="Faculty"
                                              asp-action="ApproveEvent"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@eventItem.Id" />

                                            <button type="submit"
                                                    class="faculty-action-btn faculty-action-success">
                                                Approve
                                            </button>

                                        </form>


                                        <form asp-controller="Faculty"
                                              asp-action="RejectEvent"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@eventItem.Id" />

                                            <button type="submit"
                                                    class="faculty-action-btn faculty-action-danger">
                                                Reject
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="faculty-empty">
                No pending event approvals right now.
            </div>
        }

    </div>


    <!-- =========================================================
         PENDING CLUB PRESIDENT REQUESTS
         ========================================================= -->
    @if (pendingPresidentRequests.Any())
    {
        <div class="faculty-section">

            <div class="faculty-section-header">

                <div>
                    <h2 class="faculty-section-title">
                        Pending Club President Requests
                    </h2>

                    <p class="faculty-section-subtitle">
                        Review club president requests for your supervised clubs.
                    </p>
                </div>

                <span class="faculty-status faculty-status-pending">
                    @pendingPresidentRequests.Count() Pending
                </span>

            </div>


            <div class="table-responsive">

                <table class="faculty-table">

                    <thead>
                        <tr>
                            <th>Club</th>
                            <th>President</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var request in pendingPresidentRequests)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @request.Club?.Name
                                    </strong>
                                </td>

                                <td>
                                    @request.User?.UserName
                                </td>

                                <td>

                                    <div class="faculty-action-group">

                                        <form asp-controller="Faculty"
                                              asp-action="ApprovePresident"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@request.Id" />

                                            <button type="submit"
                                                    class="faculty-action-btn faculty-action-success">
                                                Approve
                                            </button>

                                        </form>


                                        <form asp-controller="Faculty"
                                              asp-action="RejectPresident"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@request.Id" />

                                            <button type="submit"
                                                    class="faculty-action-btn faculty-action-danger">
                                                Reject
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }


    <!-- =========================================================
         VOLUNTEER APPLICATIONS
         ========================================================= -->

    <div class="faculty-section">

        <div class="faculty-section-header">

            <div>
                <h2 class="faculty-section-title">
                    Pending Volunteer Applications
                </h2>

                <p class="faculty-section-subtitle">
                    Review volunteer applications that require attention.
                </p>
            </div>

            @if (pendingVolunteerApplications.Any())
            {
                <span class="faculty-status faculty-status-pending">
                    @pendingVolunteerApplications.Count() Pending
                </span>
            }

        </div>


        @if (pendingVolunteerApplications.Any())
        {
            <div class="table-responsive">

                <table class="faculty-table">

                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Event</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var application in pendingVolunteerApplications)
                        {
                            <tr>

                                <td>
                                    @application.VolunteerUser?.UserName
                                </td>

                                <td>
                                    @application.Event?.Name
                                </td>

                                <td>
                                    <span class="faculty-status faculty-status-pending">
                                        Pending
                                    </span>
                                </td>

                                <td>

                                    @if (application.Event != null)
                                    {
                                        <a asp-controller="Volunteer"
                                           asp-action="EventVolunteers"
                                           asp-route-eventId="@application.Event.Id"
                                           class="faculty-action-btn faculty-action-primary">
                                            Review
                                        </a>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="faculty-empty">
                No pending volunteer applications right now.
            </div>
        }

    </div>


    <!-- =========================================================
         SUPERVISED CLUBS
         ========================================================= -->

    <div class="faculty-section">

        <div class="faculty-section-header">

            <div>
                <h2 class="faculty-section-title">
                    Supervised Clubs
                </h2>

                <p class="faculty-section-subtitle">
                    Clubs currently assigned to you for supervision.
                </p>
            </div>

        </div>


        @if (supervisedClubs.Any())
        {
            <div class="faculty-club-grid">

                @foreach (var club in supervisedClubs)
                {
                    <div class="faculty-club-card">

                        <div class="faculty-club-name">
                            @club.Name
                        </div>

                        @if (club.ClubPresident != null)
                        {
                            <div class="faculty-club-detail">
                                President:
                                @club.ClubPresident.UserName
                            </div>
                        }
                        else
                        {
                            <div class="faculty-club-detail">
                                President:
                                Not assigned
                            </div>
                        }

                        <div class="faculty-club-detail">
                            Faculty Supervisor:
                            @club.FacultySupervisor?.UserName
                        </div>

                        <div class="mt-3">

                            <a asp-controller="Faculty"
                               asp-action="ClubDetails"
                               asp-route-id="@club.Id"
                               class="faculty-action-btn faculty-action-primary">
                                View Club
                            </a>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="faculty-empty">
                No supervised clubs found.
            </div>
        }

    </div>


    <!-- =========================================================
         MY EVENTS
         ========================================================= -->

    <div class="faculty-section">

        <div class="faculty-section-header">

            <div>
                <h2 class="faculty-section-title">
                    My Events
                </h2>

                <p class="faculty-section-subtitle">
                    Events created and managed by you.
                </p>
            </div>

            @if (myEvents.Any())
            {
                <span class="faculty-status faculty-status-approved">
                    @myEvents.Count() Events
                </span>
            }

        </div>


        @if (myEvents.Any())
        {
            <div class="table-responsive">

                <table class="faculty-table">

                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Type</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var eventItem in myEvents)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @eventItem.Name
                                    </strong>
                                </td>

                                <td>
                                    @eventItem.StartDateTime.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @eventItem.EventType
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="faculty-empty">
                You have not created any events yet.
            </div>
        }

    </div>


    <!-- =========================================================
         APPROVAL SUMMARY
         ========================================================= -->

    <div class="faculty-section">

        <div class="faculty-section-header">

            <div>
                <h2 class="faculty-section-title">
                    Approval Summary
                </h2>

                <p class="faculty-section-subtitle">
                    Quick overview of items requiring your attention.
                </p>
            </div>

        </div>


        <div class="faculty-summary-grid">

            <div class="faculty-summary-card">

                <div class="faculty-summary-number">
                    @pendingEvents.Count()
                </div>

                <div class="faculty-summary-label">
                    Pending Event Approvals
                </div>

            </div>


            <div class="faculty-summary-card">

                <div class="faculty-summary-number">
                    @pendingVolunteerCount
                </div>

                <div class="faculty-summary-label">
                    Pending Volunteer Applications
                </div>

            </div>


            <div class="faculty-summary-card">

                <div class="faculty-summary-number">
                    @pendingPresidentRequests.Count()
                </div>

                <div class="faculty-summary-label">
                    Pending Club President Requests
                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         ALERTS
         ========================================================= -->

    <div class="mt-4">
        <partial name="_Alerts" />
    </div>

</div>
