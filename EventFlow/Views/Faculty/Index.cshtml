@{
    ViewData["Title"] = "Faculty Dashboard";

    var supervisedClubs =
        ViewBag.SupervisedClubs as IEnumerable<EventFlow.Models.Club>
        ?? Enumerable.Empty<EventFlow.Models.Club>();

    var pendingEvents =
        ViewBag.PendingEvents as IEnumerable<EventFlow.Models.Event>
        ?? Enumerable.Empty<EventFlow.Models.Event>();

    var myEvents =
        ViewBag.MyEvents as IEnumerable<EventFlow.Models.Event>
        ?? Enumerable.Empty<EventFlow.Models.Event>();

    var pendingVolunteerApplications =
        ViewBag.PendingVolunteerApplications as IEnumerable<EventFlow.Models.Volunteer>
        ?? Enumerable.Empty<EventFlow.Models.Volunteer>();

    int pendingVolunteerCount =
        Convert.ToInt32(ViewBag.PendingVolunteerCount ?? 0);

    var pendingPresidentRequests =
        ViewBag.PendingPresidentRequests as IEnumerable<dynamic>
        ?? Enumerable.Empty<dynamic>();

    var pendingEventCount = pendingEvents.Count();
    var supervisedClubCount = supervisedClubs.Count();
    var myEventCount = myEvents.Count();
    var pendingPresidentCount = pendingPresidentRequests.Count();

    var totalAttentionItems =
        pendingEventCount +
        pendingVolunteerCount +
        pendingPresidentCount;

    var totalManagedItems =
        supervisedClubCount +
        myEventCount;

    var attentionPercent =
        totalManagedItems > 0
            ? Math.Min(
                100,
                (totalAttentionItems * 100) /
                Math.Max(totalManagedItems, 1))
            : 0;
}

<style>
    .faculty-dashboard-modern {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* =========================================================
           WELCOME BANNER
           ========================================================= */

    .faculty-welcome-banner {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 190px;
        padding: 38px 45px;
        margin-bottom: 28px;
        border-radius: 24px;
        background: linear-gradient( 135deg, #312e81 0%, #4338ca 55%, #5b21b6 100% );
        color: white;
        box-shadow: 0 15px 35px rgba(67, 56, 202, 0.20);
    }

        .faculty-welcome-banner::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            right: 80px;
            top: -150px;
            border: 1px solid rgba(255, 255, 255, 0.13);
            border-radius: 50%;
        }

        .faculty-welcome-banner::after {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            right: 125px;
            top: -105px;
            border: 1px solid rgba(255, 255, 255, 0.10);
            border-radius: 50%;
        }

    .faculty-welcome-content {
        position: relative;
        z-index: 2;
    }

    .faculty-welcome-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 1.6px;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.65);
        margin-bottom: 10px;
    }

    .faculty-welcome-content h1 {
        font-size: 2.5rem;
        font-weight: 750;
        margin: 0 0 10px;
        color: white;
    }

    .faculty-welcome-content p {
        margin: 0;
        color: rgba(255, 255, 255, 0.75);
        font-size: 0.98rem;
    }

    .faculty-welcome-icon {
        position: relative;
        z-index: 2;
        width: 90px;
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.13);
        border: 1px solid rgba(255, 255, 255, 0.15);
        font-size: 2.4rem;
        backdrop-filter: blur(8px);
    }

    /* =========================================================
           ANALYTICS CARDS
           ========================================================= */

    .faculty-analytics-card {
        position: relative;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 25px;
        min-height: 180px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .faculty-analytics-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.07);
        }

        .faculty-analytics-card::after {
            content: "";
            position: absolute;
            width: 110px;
            height: 110px;
            right: -40px;
            bottom: -45px;
            border-radius: 50%;
            background: #eef2ff;
        }

    .faculty-analytics-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 1.35rem;
        margin-bottom: 18px;
    }

    .faculty-approval-card .faculty-analytics-icon {
        background: #fff7ed;
    }

    .faculty-volunteer-card .faculty-analytics-icon {
        background: #fef3c7;
    }

    .faculty-club-card .faculty-analytics-icon {
        background: #eef2ff;
    }

    .faculty-event-card .faculty-analytics-icon {
        background: #ede9fe;
    }

    .faculty-president-card .faculty-analytics-icon {
        background: #eff6ff;
    }

    .faculty-analytics-title {
        position: relative;
        z-index: 2;
        color: #6b7280;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 7px;
    }

    .faculty-analytics-number {
        position: relative;
        z-index: 2;
        color: #111827;
        font-size: 2.3rem;
        line-height: 1;
        font-weight: 750;
        margin-bottom: 9px;
    }

    .faculty-analytics-subtitle {
        position: relative;
        z-index: 2;
        color: #9ca3af;
        font-size: 0.82rem;
    }

    /* =========================================================
           OVERVIEW
           ========================================================= */

    .faculty-overview-section {
        margin-top: 28px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.035);
    }

    .faculty-section-label {
        color: #6366f1;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.4px;
        margin-bottom: 5px;
    }

    .faculty-section-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 5px;
    }

    .faculty-section-description {
        color: #6b7280;
        font-size: 0.88rem;
        margin: 0 0 24px;
    }

    .faculty-overview-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 0;
        border-bottom: 1px solid #f0f1f3;
    }

        .faculty-overview-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .faculty-overview-row:first-of-type {
            padding-top: 0;
        }

    .faculty-overview-name {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #374151;
        font-size: 0.92rem;
        font-weight: 600;
    }

    .faculty-overview-value {
        color: #4f46e5;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .faculty-overview-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #6366f1;
    }

        .faculty-overview-dot.green {
            background: #10b981;
        }

        .faculty-overview-dot.orange {
            background: #f59e0b;
        }

        .faculty-overview-dot.blue {
            background: #0ea5e9;
        }

    /* =========================================================
           ATTENTION SUMMARY
           ========================================================= */

    .faculty-attention-section {
        margin-top: 28px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.035);
    }

    .faculty-progress-item {
        margin-bottom: 24px;
    }

        .faculty-progress-item:last-child {
            margin-bottom: 0;
        }

    .faculty-progress-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 9px;
        color: #374151;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .faculty-progress-value {
        color: #4f46e5;
        font-weight: 700;
    }

    .faculty-progress-track {
        height: 10px;
        overflow: hidden;
        border-radius: 999px;
        background: #eef2f7;
    }

    .faculty-progress-bar {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient( 90deg, #4338ca, #6366f1 );
        transition: width 0.3s ease;
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 900px) {

        .faculty-welcome-banner {
            padding: 32px 35px;
        }

        .faculty-welcome-content h1 {
            font-size: 2.2rem;
        }

        .faculty-welcome-icon {
            width: 75px;
            height: 75px;
            font-size: 2rem;
        }
    }

    @@media (max-width: 576px) {

        .faculty-dashboard-modern {
            padding: 0 3px;
        }

        .faculty-welcome-banner {
            padding: 28px 25px;
            min-height: 170px;
            border-radius: 20px;
        }

        .faculty-welcome-content h1 {
            font-size: 1.8rem;
        }

        .faculty-welcome-content p {
            font-size: 0.88rem;
        }

        .faculty-welcome-icon {
            display: none;
        }

        .faculty-analytics-card {
            min-height: 160px;
        }

        .faculty-analytics-number {
            font-size: 2rem;
        }

        .faculty-overview-section,
        .faculty-attention-section {
            padding: 22px;
        }
    }
</style>

<div class="container py-4">

    <div class="faculty-dashboard-modern">

        <partial name="_Alerts" />

        <!-- =====================================================
             WELCOME
             ====================================================== -->

        <div class="faculty-welcome-banner">

            <div class="faculty-welcome-content">

                <div class="faculty-welcome-label">
                    FACULTY PORTAL
                </div>

                <h1>
                    Welcome back, Faculty 👨‍🏫
                </h1>

                <p>
                    Here's an overview of your event approvals,
                    clubs, volunteers and event activity.
                </p>

            </div>

            <div class="faculty-welcome-icon">
                👨‍🏫
            </div>

        </div>


        <!-- =====================================================
             ANALYTICS
             No navigation/action buttons here.
             ====================================================== -->

        <div class="row g-4">

            <!-- PENDING EVENT APPROVALS -->

            <div class="col-md-6 col-xl-3">

                <div class="faculty-analytics-card faculty-approval-card">

                    <div class="faculty-analytics-icon">
                        ⏳
                    </div>

                    <div class="faculty-analytics-title">
                        Pending Approvals
                    </div>

                    <div class="faculty-analytics-number">
                        @pendingEventCount
                    </div>

                    <div class="faculty-analytics-subtitle">
                        Events awaiting your review
                    </div>

                </div>

            </div>


            <!-- PENDING VOLUNTEERS -->

            <div class="col-md-6 col-xl-3">

                <div class="faculty-analytics-card faculty-volunteer-card">

                    <div class="faculty-analytics-icon">
                        🙋
                    </div>

                    <div class="faculty-analytics-title">
                        Pending Volunteers
                    </div>

                    <div class="faculty-analytics-number">
                        @pendingVolunteerCount
                    </div>

                    <div class="faculty-analytics-subtitle">
                        Applications requiring attention
                    </div>

                </div>

            </div>


            <!-- SUPERVISED CLUBS -->

            <div class="col-md-6 col-xl-3">

                <div class="faculty-analytics-card faculty-club-card">

                    <div class="faculty-analytics-icon">
                        🏛️
                    </div>

                    <div class="faculty-analytics-title">
                        Supervised Clubs
                    </div>

                    <div class="faculty-analytics-number">
                        @supervisedClubCount
                    </div>

                    <div class="faculty-analytics-subtitle">
                        Clubs under your supervision
                    </div>

                </div>

            </div>


            <!-- MY EVENTS -->

            <div class="col-md-6 col-xl-3">

                <div class="faculty-analytics-card faculty-event-card">

                    <div class="faculty-analytics-icon">
                        📅
                    </div>

                    <div class="faculty-analytics-title">
                        My Events
                    </div>

                    <div class="faculty-analytics-number">
                        @myEventCount
                    </div>

                    <div class="faculty-analytics-subtitle">
                        Events created by you
                    </div>

                </div>

            </div>


            <!-- PRESIDENT REQUESTS -->

            <div class="col-md-6 col-xl-3">

                <div class="faculty-analytics-card faculty-president-card">

                    <div class="faculty-analytics-icon">
                        👤
                    </div>

                    <div class="faculty-analytics-title">
                        President Requests
                    </div>

                    <div class="faculty-analytics-number">
                        @pendingPresidentCount
                    </div>

                    <div class="faculty-analytics-subtitle">
                        Club president requests pending
                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             FACULTY OVERVIEW
             ====================================================== -->

        <div class="faculty-overview-section">

            <div class="faculty-section-label">
                FACULTY OVERVIEW
            </div>

            <h2 class="faculty-section-title">
                Current Activity
            </h2>

            <p class="faculty-section-description">
                A quick summary of the areas currently requiring
                your attention.
            </p>


            <div class="faculty-overview-row">

                <div class="faculty-overview-name">
                    <span class="faculty-overview-dot orange"></span>
                    Events awaiting approval
                </div>

                <div class="faculty-overview-value">
                    @pendingEventCount
                </div>

            </div>


            <div class="faculty-overview-row">

                <div class="faculty-overview-name">
                    <span class="faculty-overview-dot orange"></span>
                    Volunteer applications awaiting review
                </div>

                <div class="faculty-overview-value">
                    @pendingVolunteerCount
                </div>

            </div>


            <div class="faculty-overview-row">

                <div class="faculty-overview-name">
                    <span class="faculty-overview-dot blue"></span>
                    Club president requests
                </div>

                <div class="faculty-overview-value">
                    @pendingPresidentCount
                </div>

            </div>


            <div class="faculty-overview-row">

                <div class="faculty-overview-name">
                    <span class="faculty-overview-dot green"></span>
                    Supervised clubs
                </div>

                <div class="faculty-overview-value">
                    @supervisedClubCount
                </div>

            </div>


            <div class="faculty-overview-row">

                <div class="faculty-overview-name">
                    <span class="faculty-overview-dot"></span>
                    Events created by you
                </div>

                <div class="faculty-overview-value">
                    @myEventCount
                </div>

            </div>

        </div>


        <!-- =====================================================
             WORKLOAD / ATTENTION SUMMARY
             ====================================================== -->

        <div class="faculty-attention-section">

            <div class="faculty-section-label">
                WORKLOAD SUMMARY
            </div>

            <h2 class="faculty-section-title">
                Items Requiring Attention
            </h2>

            <p class="faculty-section-description">
                Overview of pending items currently associated
                with your faculty responsibilities.
            </p>


            <!-- EVENT APPROVALS -->

            <div class="faculty-progress-item">

                <div class="faculty-progress-header">

                    <span>
                        Event Approvals
                    </span>

                    <span class="faculty-progress-value">
                        @pendingEventCount
                    </span>

                </div>

                <div class="faculty-progress-track">

                    <div class="faculty-progress-bar"
                         style="width: @(Math.Min(100, pendingEventCount * 20))%;">
                    </div>

                </div>

            </div>


            <!-- VOLUNTEER APPLICATIONS -->

            <div class="faculty-progress-item">

                <div class="faculty-progress-header">

                    <span>
                        Volunteer Applications
                    </span>

                    <span class="faculty-progress-value">
                        @pendingVolunteerCount
                    </span>

                </div>

                <div class="faculty-progress-track">

                    <div class="faculty-progress-bar"
                         style="width: @(Math.Min(100, pendingVolunteerCount * 20))%;">
                    </div>

                </div>

            </div>


            <!-- PRESIDENT REQUESTS -->

            <div class="faculty-progress-item">

                <div class="faculty-progress-header">

                    <span>
                        Club President Requests
                    </span>

                    <span class="faculty-progress-value">
                        @pendingPresidentCount
                    </span>

                </div>

                <div class="faculty-progress-track">

                    <div class="faculty-progress-bar"
                         style="width: @(Math.Min(100, pendingPresidentCount * 20))%;">
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>