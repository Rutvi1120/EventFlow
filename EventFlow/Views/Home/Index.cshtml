@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">
    <div class="row align-items-center min-vh-75">
        <div class="col-lg-7">
            <span class="badge bg-primary mb-3">
                College Event Management
            </span>

            <h1 class="display-4 fw-bold mb-3">
                Welcome to EventFlow
            </h1>

            <p class="lead text-muted mb-4">
                Discover college events, organize activities,
                manage clubs, register for events, and volunteer
                for activities across the campus.
            </p>

            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Events"
                   asp-action="Index"
                   class="btn btn-primary btn-lg">
                    Explore Events
                </a>

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-area="Identity"
                       asp-page="/Account/Register"
                       class="btn btn-outline-primary btn-lg">
                        Create Account
                    </a>
                }
            </div>
        </div>

        <div class="col-lg-5 mt-5 mt-lg-0">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h3 class="mb-4">
                        EventFlow
                    </h3>

                    <div class="mb-3">
                        <h5>Discover</h5>
                        <p class="text-muted mb-0">
                            Find approved college events and activities.
                        </p>
                    </div>

                    <div class="mb-3">
                        <h5>Organize</h5>
                        <p class="text-muted mb-0">
                            Create student, club, and college events.
                        </p>
                    </div>

                    <div class="mb-3">
                        <h5>Participate</h5>
                        <p class="text-muted mb-0">
                            Register for events or join the waitlist.
                        </p>
                    </div>

                    <div>
                        <h5>Volunteer</h5>
                        <p class="text-muted mb-0">
                            Apply for volunteer roles at events.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>