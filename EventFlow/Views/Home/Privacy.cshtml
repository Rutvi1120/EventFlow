@{
    ViewData["Title"] = "Privacy";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <h1>Privacy</h1>

            <p class="text-muted">
                Your account information is used to provide
                EventFlow services and manage your participation
                in college events.
            </p>

            <h4 class="mt-4">
                Account Information
            </h4>

            <p>
                EventFlow may store information such as your name,
                email address, department, student ID, and account role.
            </p>

            <h4 class="mt-4">
                Event Information
            </h4>

            <p>
                Event registrations, waitlist entries, event
                organization, and volunteer assignments are stored
                to provide event-management functionality.
            </p>

            <h4 class="mt-4">
                Account Security
            </h4>

            <p>
                Authentication and authorization are managed through
                ASP.NET Core Identity.
            </p>
        </div>
    </div>
</div>