@model IEnumerable<EventFlow.Models.Registration>

@{
    ViewData["Title"] = "My Registrations";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>My Registrations</h1>
        <p class="text-muted">
            Events you are registered for.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You are not registered for any events.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var registration in Model)
            {
                var eventItem = registration.Event;

                if (eventItem == null)
                {
                    continue;
                }

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-primary align-self-start mb-2">
                                @eventItem.EventType
                            </span>

                            <h4>
                                @eventItem.Name
                            </h4>

                            <p class="text-muted">
                                @eventItem.Description
                            </p>

                            <div class="mt-auto">
                                <div class="mb-2">
                                    <strong>Date:</strong>
                                    @eventItem.StartDateTime
                                    .ToString("dd MMM yyyy")
                                </div>

                                <div class="mb-3">
                                    <strong>Time:</strong>
                                    @eventItem.StartDateTime
                                    .ToString("hh:mm tt")
                                </div>

                                <div class="d-flex gap-2">
                                    <a asp-controller="Events"
                                       asp-action="Details"
                                       asp-route-id="@eventItem.Id"
                                       class="btn btn-outline-primary flex-grow-1">
                                        Details
                                    </a>

                                    @if (eventItem.EndDateTime > DateTime.Now)
                                    {
                                        <form asp-controller="Registration"
                                              asp-action="Cancel"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="eventId"
                                                   value="@eventItem.Id" />

                                            <button type="submit"
                                                    class="btn btn-outline-danger">
                                                Cancel
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>