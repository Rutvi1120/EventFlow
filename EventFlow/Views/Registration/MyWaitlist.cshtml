@model IEnumerable<EventFlow.Models.WaitlistEntry>

@{
    ViewData["Title"] = "My Waitlist";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>My Waitlist</h1>
        <p class="text-muted">
            Events where you are currently waiting for a seat.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You are not currently on any event waitlists.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Event Type</th>
                        <th>Joined On</th>
                        <th>Event Date</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var waitlistEntry in Model)
                    {
                        var eventItem = waitlistEntry.Event;

                        if (eventItem == null)
                        {
                            continue;
                        }

                        <tr>
                            <td>
                                <strong>@eventItem.Name</strong>
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @eventItem.EventType
                                </span>
                            </td>

                            <td>
                                @waitlistEntry.JoinedAt.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                            </td>

                            <td>
                                @eventItem.StartDateTime.ToString("dd MMM yyyy hh:mm tt")
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (eventItem.ApprovalStatus == "Approved")
                                    {
                                        <a asp-controller="Events"
                                           asp-action="Details"
                                           asp-route-id="@eventItem.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>
                                    }

                                    @if (eventItem.EndDateTime > DateTime.Now)
                                    {
                                        <form asp-controller="Registration"
                                              asp-action="LeaveWaitlist"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="eventId"
                                                   value="@eventItem.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Leave
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>