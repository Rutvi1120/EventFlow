<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

     
    <title>@ViewData["Title"] - EventFlow</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EventFlow.styles.css" asp-append-version="true" />
     

</head>

<body>

     
    <!-- NAVBAR -->
    <header class="ef-navbar-wrapper">
        <nav class="ef-navbar">

            <div class="ef-navbar-container">

                <!-- Logo -->
                <a class="ef-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="ef-brand-icon">E</span>

                    <span class="ef-brand-text">
                        Event<span>Flow</span>
                    </span>

                </a>

                <!-- Navigation -->
                <div class="ef-nav-links">

                    <a href="#home" class="ef-nav-link active">
                        Home
                    </a>

                    <a href="#features" class="ef-nav-link">
                        Features
                    </a>

                    <a href="#workflow" class="ef-nav-link">
                        How It Works
                    </a>

                    <a href="#roles" class="ef-nav-link">
                        Roles
                    </a>

                </div>

                <!-- Authentication -->
                <div class="ef-navbar-actions">
                    <partial name="_LoginPartial" />
                </div>

            </div>

        </nav>
    </header>


    <!-- PAGE CONTENT -->
    <main role="main">
        @RenderBody()
    </main>


    <!-- FOOTER -->
    <footer class="ef-footer">

        <div class="ef-footer-container">

            <div class="ef-footer-main">

                <a class="ef-footer-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="ef-brand-icon">E</span>

                    <span class="ef-brand-text">
                        Event<span>Flow</span>
                    </span>

                </a>

                <p>
                    A simple and powerful event coordination platform
                    designed to make planning and managing events easier.
                </p>

            </div>


            <div class="ef-footer-section">

                <h4>Platform</h4>

                <a href="#features">Features</a>
                <a href="#workflow">How It Works</a>
                <a href="#roles">Roles</a>

            </div>


            <div class="ef-footer-section">

                <h4>Account</h4>

                <a asp-area="Identity"
                   asp-page="/Account/Login">
                    Login
                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Register">
                    Register
                </a>

            </div>

        </div>


        <div class="ef-footer-bottom">

            <span>
                © 2026 EventFlow
            </span>

            <span>
                Event Coordination & Management System
            </span>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
     

</body>
</html>
partial
