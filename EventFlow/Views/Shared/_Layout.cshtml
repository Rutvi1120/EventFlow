                width: 100%;
                min-width: 100%;
                min-height: auto;
            }

            .admin-main,
            .student-main,
            .faculty-main,
            .club-president-main {
                width: 100%;
                margin-left: 0;
            }

            .admin-layout,
            .student-layout,
            .faculty-layout,
            .club-president-layout {
                display: block;
            }

            .admin-sidebar-bottom,
