<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EventFlow</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        /* =========================================================
           EVENTFLOW GLOBAL
        ========================================================= */

        body {
            margin: 0;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f7fb;
            color: #1f2937;
        }

        main {
            min-height: calc(100vh - 150px);
        }

        /* =========================================================
           NORMAL NAVBAR
           Used for Student / Faculty / ClubPresident / Guest
        ========================================================= */

        .eventflow-navbar {
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            box-shadow: 0 4px 18px rgba(79, 70, 229, 0.20);
            padding: 10px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .eventflow-navbar .container {
            max-width: 1400px;
        }

        .eventflow-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: white !important;
            font-size: 1.35rem;
            font-weight: 700;
            text-decoration: none;
            letter-spacing: 0.3px;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.18);
            color: white;
            font-size: 20px;
            backdrop-filter: blur(10px);
        }

        .brand-text {
            line-height: 1;
        }

        .brand-subtitle {
            display: block;
            font-size: 0.65rem;
            font-weight: 400;
            opacity: 0.8;
            margin-top: 4px;
            letter-spacing: 0.5px;
        }

        .eventflow-navbar .navbar-nav {
            gap: 4px;
        }

        .eventflow-navbar .nav-link {
            color: rgba(255, 255, 255, 0.88) !important;
            font-size: 0.93rem;
            font-weight: 500;
            padding: 9px 13px !important;
            border-radius: 9px;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .eventflow-navbar .nav-link:hover {
            color: white !important;
            background: rgba(255, 255, 255, 0.15);
            transform: translateY(-1px);
        }

        .login-area {
            margin-left: 10px;
        }

        /* =========================================================
           ADMIN SIDEBAR
        ========================================================= */

        .admin-layout {
            min-height: 100vh;
            display: flex;
        }

        .admin-sidebar {
            width: 260px;
            min-width: 260px;
            min-height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            z-index: 1100;

            background: linear-gradient(
                180deg,
                #312e81 0%,
                #4338ca 55%,
                #5b21b6 100%
            );

            color: white;
            box-shadow: 4px 0 20px rgba(0, 0, 0, 0.12);

            display: flex;
            flex-direction: column;
        }

        /* Admin brand */

        .admin-brand {
            padding: 24px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        }

        .admin-brand-link {
            display: flex;
            align-items: center;
            gap: 12px;
            color: white !important;
            text-decoration: none;
        }

        .admin-brand-icon {
            width: 44px;
            height: 44px;
            border-radius: 13px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: rgba(255, 255, 255, 0.16);
            font-size: 21px;
        }

        .admin-brand-name {
            font-size: 1.3rem;
            font-weight: 700;
            line-height: 1.1;
        }

        .admin-brand-subtitle {
            display: block;
            font-size: 0.68rem;
            font-weight: 400;
            opacity: 0.75;
            margin-top: 4px;
        }

        /* Admin label */

        .admin-panel-label {
            padding: 22px 20px 10px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.55);
        }

        /* Sidebar links */

        .admin-sidebar-nav {
            padding: 0 12px;
            flex: 1;
        }

        .admin-sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;

            width: 100%;
            padding: 12px 14px;
            margin-bottom: 5px;

            color: rgba(255, 255, 255, 0.82);
            text-decoration: none;

            border-radius: 10px;

            font-size: 0.94rem;
            font-weight: 500;

            transition: all 0.2s ease;
        }

        .admin-sidebar-link:hover {
            color: white;
            background: rgba(255, 255, 255, 0.12);
            transform: translateX(3px);
        }

        .admin-sidebar-link.active {
            color: white;
            background: rgba(255, 255, 255, 0.18);
            box-shadow: inset 3px 0 0 white;
        }

        .admin-sidebar-icon {
            width: 24px;
            text-align: center;
            font-size: 1.05rem;
        }

        /* Sidebar bottom */

        .admin-sidebar-bottom {
            padding: 15px 12px 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.12);
        }

        .admin-user-box {
            padding: 12px;
            margin-bottom: 10px;
            border-radius: 11px;
            background: rgba(255, 255, 255, 0.08);
        }

        .admin-user-name {
            font-size: 0.9rem;
            font-weight: 600;
        }

        .admin-user-role {
            font-size: 0.72rem;
            opacity: 0.65;
            margin-top: 2px;
        }

        .admin-logout {
            display: flex;
            align-items: center;
            gap: 10px;

            width: 100%;
            padding: 10px 13px;

            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;

            border-radius: 9px;

            font-size: 0.9rem;
        }

        .admin-logout:hover {
            color: white;
            background: rgba(255, 255, 255, 0.1);
        }

        /* =========================================================
           ADMIN MAIN CONTENT
        ========================================================= */

        .admin-main {
            width: calc(100% - 260px);
            margin-left: 260px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .admin-topbar {
            min-height: 70px;
            background: white;
            border-bottom: 1px solid #e5e7eb;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 30px;

            position: sticky;
            top: 0;
            z-index: 900;
        }

        .admin-topbar-title {
            font-size: 1rem;
            font-weight: 600;
            color: #374151;
        }

        .admin-topbar-subtitle {
            font-size: 0.8rem;
            color: #9ca3af;
        }

        .admin-content {
            flex: 1;
            padding: 30px;
        }

        /* =========================================================
           ADMIN DASHBOARD
        ========================================================= */

        .admin-dashboard-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 28px;
        }

        .admin-dashboard-title {
            font-size: 2rem;
            font-weight: 700;
            color: #111827;
            margin-bottom: 6px;
        }

        .admin-dashboard-description {
            color: #6b7280;
            margin: 0;
        }

        .admin-welcome {
            padding: 10px 16px;
            border-radius: 10px;
            background: #eef2ff;
            color: #4338ca;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .admin-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            padding: 22px;
            height: 100%;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
            transition: all 0.2s ease;
        }

        .admin-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        }

        .admin-card-icon {
            width: 48px;
            height: 48px;
            border-radius: 13px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #eef2ff;
            color: #4f46e5;

            font-size: 21px;

            margin-bottom: 17px;
        }

        .admin-card-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: #111827;
            margin-bottom: 7px;
        }

        .admin-card-text {
            color: #6b7280;
            font-size: 0.88rem;
            line-height: 1.5;
            min-height: 44px;
            margin-bottom: 18px;
        }

        .admin-card-btn {
            border-radius: 9px;
            font-size: 0.86rem;
            font-weight: 600;
            padding: 8px 15px;
        }

        /* =========================================================
           FOOTER
        ========================================================= */

        .eventflow-footer {
            background: #111827;
            color: #9ca3af;
            margin-top: 40px;
            padding: 35px 0 20px;
        }

        .footer-brand {
            color: white;
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .footer-description {
            font-size: 0.9rem;
            max-width: 500px;
            line-height: 1.6;
        }

        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            margin-top: 25px;
            padding-top: 18px;
            font-size: 0.85rem;
        }

        /* =========================================================
           MOBILE
        ========================================================= */

        .admin-mobile-header {
            display: none;
        }

        @@media (max-width: 991px) {

            .admin-sidebar {
                width: 220px;
                min-width: 220px;
            }

            .admin-main {
                width: calc(100% - 220px);
                margin-left: 220px;
            }

            .admin-content {
                padding: 20px;
            }

            .admin-topbar {
                padding: 0 20px;
            }

            .eventflow-navbar .navbar-collapse {
                margin-top: 12px;
                padding: 10px;
                border-radius: 12px;
                background: rgba(0, 0, 0, 0.12);
            }

            .eventflow-navbar .nav-link {
                padding: 11px 13px !important;
            }

            .login-area {
                margin-left: 0;
                margin-top: 10px;
                padding-top: 10px;
                border-top: 1px solid rgba(255, 255, 255, 0.15);
            }
        }

        @@media (max-width: 767px) {

            .admin-sidebar {
                position: relative;
                width: 100%;
                min-width: 100%;
                min-height: auto;
            }

            .admin-main {
                width: 100%;
                margin-left: 0;
            }

            .admin-layout {
                display: block;
            }

            .admin-sidebar-nav {
                padding-bottom: 10px;
            }

            .admin-sidebar-bottom {
                display: none;
            }

            .admin-dashboard-header {
                display: block;
            }

            .admin-welcome {
                display: inline-block;
                margin-top: 15px;
            }

            .admin-topbar {
                position: relative;
            }
        }

        @@media (max-width: 576px) {

            .eventflow-brand {
                font-size: 1.15rem;
            }

            .brand-icon {
                width: 36px;
                height: 36px;
                font-size: 18px;
            }

            .brand-subtitle {
                font-size: 0.58rem;
            }

            .admin-content {
                padding: 15px;
            }

            .admin-dashboard-title {
                font-size: 1.6rem;
            }
        }
    </style>
</head>

<body>

    @if (User.Identity?.IsAuthenticated == true &&
         User.IsInRole("Admin"))
    {
        <!-- =====================================================
             ADMIN LAYOUT
        ====================================================== -->

        <div class="admin-layout">

            <!-- ================= ADMIN SIDEBAR ================= -->

            <aside class="admin-sidebar">

                <!-- Brand -->
                <div class="admin-brand">

                    <a class="admin-brand-link"
                       asp-controller="Admin"
                       asp-action="Index">

                        <span class="admin-brand-icon">
                            📅
                        </span>

                        <span>
                            <span class="admin-brand-name">
                                EventFlow
                            </span>

                            <span class="admin-brand-subtitle">
                                Admin Panel
                            </span>
                        </span>

                    </a>

                </div>


                <!-- Navigation label -->
                <div class="admin-panel-label">
                    Administration
                </div>


                <!-- Navigation -->
                <nav class="admin-sidebar-nav">

                    <!-- Dashboard -->
                    <a class="admin-sidebar-link
                       @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" &&
                         ViewContext.RouteData.Values["action"]?.ToString() == "Index"
                         ? "active" : "")"
                       asp-controller="Admin"
                       asp-action="Index">

                        <span class="admin-sidebar-icon">
                            🏠
                        </span>

                        <span>Dashboard</span>
                    </a>


                    <!-- Users -->
                    <a class="admin-sidebar-link
                       @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" &&
                         ViewContext.RouteData.Values["action"]?.ToString() == "Users"
                         ? "active" : "")"
                       asp-controller="Admin"
                       asp-action="Users">

                        <span class="admin-sidebar-icon">
                            👥
                        </span>

                        <span>Users</span>
                    </a>


                    <!-- Events -->
                    <a class="admin-sidebar-link
                       @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" &&
                         ViewContext.RouteData.Values["action"]?.ToString() == "Events"
                         ? "active" : "")"
                       asp-controller="Admin"
                       asp-action="Events">

                        <span class="admin-sidebar-icon">
                            📅
                        </span>

                        <span>Events</span>
                    </a>


                    <!-- Venues -->
                    <a class="admin-sidebar-link
                       @(ViewContext.RouteData.Values["controller"]?.ToString() == "Venue"
                         ? "active" : "")"
                       asp-controller="Venue"
                       asp-action="Index">

                        <span class="admin-sidebar-icon">
                            📍
                        </span>

                        <span>Venues</span>
                    </a>


                    <!-- Volunteers -->
                    <a class="admin-sidebar-link
                       @(ViewContext.RouteData.Values["controller"]?.ToString() == "Volunteer"
                         ? "active" : "")"
                       asp-controller="Volunteer"
                       asp-action="Manage">

                        <span class="admin-sidebar-icon">
                            🤝
                        </span>

                        <span>Volunteers</span>
                    </a>


                    <!-- Clubs -->
                    <a class="admin-sidebar-link
                       @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" &&
                         ViewContext.RouteData.Values["action"]?.ToString() == "Clubs"
                         ? "active" : "")"
                       asp-controller="Admin"
                       asp-action="Clubs">

                        <span class="admin-sidebar-icon">
                            🏛
                        </span>

                        <span>Clubs</span>
                    </a>


                    <!-- Roles -->
                    <a class="admin-sidebar-link
                       @(ViewContext.RouteData.Values["controller"]?.ToString() == "Role"
                         ? "active" : "")"
                       asp-controller="Role"
                       asp-action="Index">

                        <span class="admin-sidebar-icon">
                            🔐
                        </span>

                        <span>Roles</span>
                    </a>


                    <!-- Public Events -->
                    <a class="admin-sidebar-link"
                       asp-controller="Events"
                       asp-action="Index">

                        <span class="admin-sidebar-icon">
                            🌐
                        </span>

                        <span>Public Events</span>
                    </a>

                </nav>


                <!-- Bottom user section -->
                <div class="admin-sidebar-bottom">

                    <div class="admin-user-box">

                        <div class="admin-user-name">
                            @(User.Identity?.Name ?? "Administrator")
                        </div>

                        <div class="admin-user-role">
                            System Administrator
                        </div>

                    </div>

                    <div class="login-area">
                        <partial name="_LoginPartial" />
                    </div>

                </div>

            </aside>


            <!-- ================= ADMIN MAIN ================= -->

            <div class="admin-main">

                <div class="admin-topbar">

                    <div>
                        <div class="admin-topbar-title">
                            EventFlow Administration
                        </div>

                        <div class="admin-topbar-subtitle">
                            Manage your event coordination system
                        </div>
                    </div>

                    <div class="admin-welcome">
                        Administrator
                    </div>

                </div>


                <main class="admin-content">
                    @RenderBody()
                </main>

            </div>

        </div>
    }
    else
    {
        <!-- =====================================================
             NORMAL USER NAVBAR
             Student / Faculty / ClubPresident / Guest
        ====================================================== -->

        <header>

            <nav class="navbar navbar-expand-lg eventflow-navbar">

                <div class="container">

                    <!-- Brand -->
                    <a class="eventflow-brand"
                       asp-controller="Home"
                       asp-action="Index">

                        <span class="brand-icon">
                            📅
                        </span>

                        <span class="brand-text">
                            EventFlow

                            <span class="brand-subtitle">
                                Event Coordination System
                            </span>
                        </span>

                    </a>


                    <!-- Mobile button -->
                    <button class="navbar-toggler border-0 shadow-none"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainNavigation"
                            aria-controls="mainNavigation"
                            aria-expanded="false"
                            aria-label="Toggle navigation">

                        <span class="navbar-toggler-icon"></span>

                    </button>


                    <!-- Navigation -->
                    <div class="collapse navbar-collapse"
                         id="mainNavigation">

                        <ul class="navbar-nav me-auto">

                            @if (User.Identity?.IsAuthenticated != true)
                            {
                                <!-- Guest -->

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Events"
                                       asp-action="Index">

                                        📅 Events

                                    </a>

                                </li>
                            }

                            else if (User.IsInRole("Faculty"))
                            {
                                <!-- FACULTY -->

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Faculty"
                                       asp-action="Index">

                                        🏠 Dashboard

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Events"
                                       asp-action="Index">

                                        📅 Events

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Volunteer"
                                       asp-action="Manage">

                                        🤝 Volunteer Management

                                    </a>

                                </li>
                            }

                            else if (User.IsInRole("ClubPresident"))
                            {
                                <!-- CLUB PRESIDENT -->

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="ClubPresident"
                                       asp-action="Index">

                                        🏠 Dashboard

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="ClubPresident"
                                       asp-action="AllClubs">

                                        🏛 My Clubs

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="ClubPresident"
                                       asp-action="Events">

                                        📅 Club Events

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Volunteer"
                                       asp-action="Manage">

                                        🤝 Volunteer Management

                                    </a>

                                </li>
                            }

                            else if (User.IsInRole("Student"))
                            {
                                <!-- STUDENT -->

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Student"
                                       asp-action="Index">

                                        🏠 Dashboard

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Events"
                                       asp-action="Index">

                                        📅 Events

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Volunteer"
                                       asp-action="Index">

                                        🤝 Volunteer

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Volunteer"
                                       asp-action="MyApplications">

                                        📋 My Applications

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Volunteer"
                                       asp-action="Manage">

                                        🧑‍💼 Manage My Event Volunteers

                                    </a>

                                </li>
                            }

                            else
                            {
                                <!-- OTHER AUTHENTICATED USERS -->

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Events"
                                       asp-action="Index">

                                        📅 Events

                                    </a>

                                </li>
                            }

                        </ul>


                        <!-- Login / Profile -->
                        <div class="login-area">

                            <partial name="_LoginPartial" />

                        </div>

                    </div>

                </div>

            </nav>

        </header>


        <!-- Main content -->

        <main>

            @RenderBody()

        </main>


        <!-- Footer -->

        <footer class="eventflow-footer">

            <div class="container">

                <div class="row">

                    <div class="col-md-7">

                        <div class="footer-brand">
                            📅 EventFlow
                        </div>

                        <p class="footer-description mb-0">
                            A smart event coordination and management system
                            designed to simplify event planning, registration,
                            volunteering and collaboration.
                        </p>

                    </div>

                    <div class="col-md-5 text-md-end mt-3 mt-md-0">

                        <div class="mb-2">
                            <span>Event Management</span>
                        </div>

                        <div>
                            <span>
                                Registration • Volunteers • Clubs • Venues
                            </span>
                        </div>

                    </div>

                </div>

                <div class="footer-bottom text-center">

                    &copy; @DateTime.Now.Year - EventFlow.
                    All rights reserved.

                </div>

            </div>

        </footer>
    }


    <!-- Scripts -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>