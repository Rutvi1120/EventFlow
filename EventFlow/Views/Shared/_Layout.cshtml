        @@media (max-width: 991px) {

            .admin-sidebar,
            .student-sidebar,
            .faculty-sidebar,
            .club-president-sidebar {
                width: 220px;
                min-width: 220px;
            }

            .admin-main,
            .student-main,
            .faculty-main,
            .club-president-main {
                width: calc(100% - 220px);
                margin-left: 220px;
