           ADMIN SHELL
           ========================================================= */

        .admin-layout {
            min-height: 100vh;
            display: flex;
            background: #f5f7fb;
        }

        .admin-sidebar {
            width: 260px;
            min-width: 260px;
            min-height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            z-index: 1100;
            background: linear-gradient(
                180deg,
                #312e81 0%,
                #4338ca 55%,
                #5b21b6 100%
            );
            color: white;
            box-shadow: 4px 0 20px rgba(0, 0, 0, 0.12);
            display: flex;
            flex-direction: column;
        }

        .admin-brand {
            padding: 22px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        }

        .admin-brand-link {
            display: flex;
            align-items: center;
            gap: 13px;
            color: white !important;
            text-decoration: none;
        }

        .admin-brand-icon {
            width: 80px;
            height: 80px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.16);
            overflow: hidden;
            flex-shrink: 0;
        }

        .admin-brand-icon img {
            width: 62px;
            height: 62px;
            object-fit: contain;
            border-radius: 0;
        }

        .admin-brand-title {
            font-size: 1.15rem;
            font-weight: 700;
        }

        .admin-brand-subtitle {
            font-size: 0.72rem;
            opacity: 0.65;
            margin-top: 2px;
        }

        .admin-sidebar-nav {
            padding: 20px 12px;
            flex: 1;
        }

        .admin-sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            padding: 12px 14px;
            margin-bottom: 5px;
            color: rgba(255, 255, 255, 0.82);
            text-decoration: none;
            border-radius: 10px;
            font-size: 0.94rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .admin-sidebar-link:hover {
            color: white;
            background: rgba(255, 255, 255, 0.12);
            transform: translateX(3px);
        }

        .admin-sidebar-link.active {
            color: white;
            background: rgba(255, 255, 255, 0.18);
            box-shadow: inset 3px 0 0 white;
        }

        .admin-sidebar-icon {
            width: 22px;
            text-align: center;
        }

        .admin-sidebar-bottom {
            padding: 15px 12px 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.12);
        }

        .admin-user-box {
            padding: 12px;
            margin-bottom: 10px;
            border-radius: 11px;
            background: rgba(255, 255, 255, 0.08);
        }

        .admin-user-name {
            font-size: 0.9rem;
            font-weight: 600;
        }

        .admin-user-role {
            font-size: 0.72rem;
            opacity: 0.65;
            margin-top: 2px;
        }

        .admin-logout {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            padding: 10px 13px;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            border-radius: 9px;
            border: none;
            background: transparent;
            cursor: pointer;
        }

        .admin-logout:hover {
