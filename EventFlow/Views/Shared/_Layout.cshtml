<body>

@if (isIdentityPage)
{
    @RenderBody()
}
else if (isAdmin)
{
    <!-- =========================================================
         ADMIN LAYOUT
         ========================================================= -->

    <div class="admin-layout">

        <aside class="admin-sidebar">

            <div class="admin-brand">
                <a asp-controller="Admin"
                   asp-action="Index"
                   class="admin-brand-link">

                    <div class="admin-brand-icon">
                        <img src="~/images/logo.png"
                             alt="EventFlow Logo" />
                    </div>

                    <div>
                        <div class="admin-brand-title">
                            EventFlow
                        </div>

                        <div class="admin-brand-subtitle">
                            Admin Portal
                        </div>
                    </div>

                </a>
            </div>

            <nav class="admin-sidebar-nav">

                <a class="admin-sidebar-link
                    @(currentController == "Admin" && currentAction == "Index" ? "active" : "")"
                   asp-controller="Admin"
                   asp-action="Index">

                    <span class="admin-sidebar-icon">🏠</span>
                    <span>Dashboard</span>

                </a>

                <a class="admin-sidebar-link
                    @(currentController == "Admin" && currentAction == "Users" ? "active" : "")"
                   asp-controller="Admin"
                   asp-action="Users">

                    <span class="admin-sidebar-icon">👥</span>
                    <span>Users</span>

                </a>

                <a class="admin-sidebar-link
                    @(currentController == "Events" ? "active" : "")"
                   asp-controller="Events"
                   asp-action="Index">

                    <span class="admin-sidebar-icon">📅</span>
                    <span>Events</span>

                </a>

                <a class="admin-sidebar-link
                    @(currentController == "Venue" ? "active" : "")"
                   asp-controller="Venue"
                   asp-action="Index">

                    <span class="admin-sidebar-icon">📍</span>
                    <span>Venues</span>

                </a>

                <a class="admin-sidebar-link
                    @(currentController == "Admin" && currentAction == "Clubs" ? "active" : "")"
                   asp-controller="Admin"
                   asp-action="Clubs">

                    <span class="admin-sidebar-icon">🏛️</span>
                    <span>Clubs</span>

                </a>

            </nav>

            <div class="admin-sidebar-bottom">

                <div class="admin-user-box">

                    <div class="admin-user-name">
                        @User.Identity?.Name
                    </div>

                    <div class="admin-user-role">
                        Administrator
                    </div>

                </div>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="/"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="admin-logout">

                        <span>🚪</span>
                        <span>Logout</span>

                    </button>

                </form>

            </div>

        </aside>

        <main class="admin-main">

            <header class="admin-topbar">

                <div>
                    <div class="admin-topbar-title">
                        @ViewData["Title"]
                    </div>

                    <div class="admin-topbar-subtitle">
                        EventFlow Admin Portal
                    </div>
                </div>

                <div class="admin-topbar-user">
                    Welcome, @User.Identity?.Name
                </div>

            </header>

            <div class="admin-content">
                @RenderBody()
            </div>

        </main>

    </div>
}
else if (isStudent)
{
    <!-- =========================================================
         STUDENT LAYOUT
         ========================================================= -->

    <div class="student-layout">

        <aside class="student-sidebar">

            <div class="student-brand">

                <a asp-controller="Student"
                   asp-action="Index"
                   class="student-brand-link">

                    <div class="student-brand-icon">
                        <img src="~/images/logo.png"
                             alt="EventFlow Logo" />
                    </div>

                    <div>
                        <div class="student-brand-title">
                            EventFlow
                        </div>

                        <div class="student-brand-subtitle">
                            Student Portal
                        </div>
                    </div>

                </a>

            </div>

            <nav class="student-sidebar-nav">

                <a class="student-sidebar-link
                    @(currentController == "Student" && currentAction == "Index" ? "active" : "")"
                   asp-controller="Student"
                   asp-action="Index">

                    <span class="student-sidebar-icon">🏠</span>
                    <span>Dashboard</span>

                </a>

                <a class="student-sidebar-link
                    @(currentController == "Events" ? "active" : "")"
                   asp-controller="Events"
                   asp-action="Index">

                    <span class="student-sidebar-icon">📅</span>
                    <span>Events</span>

                </a>

                <a class="student-sidebar-link
                    @(currentController == "Student" && currentAction == "CreateEvent" ? "active" : "")"
                   asp-controller="Student"
                   asp-action="CreateEvent">

                    <span class="student-sidebar-icon">➕</span>
                    <span>Create Event</span>

                </a>

                <a class="student-sidebar-link
                    @(currentController == "Student" && currentAction == "MyEvents" ? "active" : "")"
                   asp-controller="Student"
                   asp-action="MyEvents">

                    <span class="student-sidebar-icon">📋</span>
                    <span>My Events</span>

                </a>

                <a class="student-sidebar-link
                    @(currentController == "Registration" ? "active" : "")"
                   asp-controller="Registration"
                   asp-action="MyRegistrations">

                    <span class="student-sidebar-icon">🎟️</span>
                    <span>Registrations</span>

                </a>
              
                    <a class="student-sidebar-link
                    @(currentController == "Volunteer" && currentAction == "MyApplications" ? "active" : "")"
                   asp-controller="Volunteer"
                   asp-action="MyApplications">

                    <span class="student-sidebar-icon">📋</span>
                    <span>My applications</span>

                </a>


            </nav>

            <div class="student-sidebar-bottom">

                <div class="student-user-box">

                    <div class="student-user-name">
                        @User.Identity?.Name
                    </div>

                    <div class="student-user-role">
                        Student
                    </div>

                </div>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="/"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="student-logout">

                        <span>🚪</span>
                        <span>Logout</span>

                    </button>

                </form>

            </div>

        </aside>

        <main class="student-main">

            <header class="student-topbar">

                <div>
                    <div class="student-topbar-title">
                        @ViewData["Title"]
                    </div>

                    <div class="student-topbar-subtitle">
                        EventFlow Student Portal
                    </div>
                </div>

                <div class="student-topbar-user">
                    Welcome, @User.Identity?.Name
                </div>

            </header>

            <div class="student-content">
                @RenderBody()
            </div>

        </main>

    </div>
}
else if (isFaculty)
{
    <!-- =========================================================
         FACULTY LAYOUT
         ========================================================= -->

    <div class="faculty-layout">

        <aside class="faculty-sidebar">

            <div class="faculty-brand">

                <a asp-controller="Faculty"
                   asp-action="Index"
                   class="faculty-brand-link">

                    <div class="faculty-brand-icon">
                        <img src="~/images/logo.png"
                             alt="EventFlow Logo" />
                    </div>

                    <div>
                        <div class="faculty-brand-title">
                            EventFlow
                        </div>

                        <div class="faculty-brand-subtitle">
                            Faculty Portal
                        </div>
                    </div>

                </a>

            </div>

            <nav class="faculty-sidebar-nav">

                <a class="faculty-sidebar-link
                    @(currentController == "Faculty" && currentAction == "Index" ? "active" : "")"
                   asp-controller="Faculty"
                   asp-action="Index">

                    <span class="faculty-sidebar-icon">🏠</span>
                    <span>Dashboard</span>

                </a>

                <a class="faculty-sidebar-link
                    @(currentController == "Faculty" && currentAction == "Events" ? "active" : "")"
                   asp-controller="Faculty"
                   asp-action="Events">

                    <span class="faculty-sidebar-icon">📅</span>
                    <span>Events</span>

                </a>

                <a class="faculty-sidebar-link
                    @(currentController == "Faculty" && (currentAction == "AllClubs" || currentAction == "ClubDetails") ? "active" : "")"
                   asp-controller="Faculty"
                   asp-action="AllClubs">

                    <span class="faculty-sidebar-icon">🏛️</span>
                    <span>Supervised Clubs</span>

                </a>

                <a class="faculty-sidebar-link
                    @(currentController == "Faculty" && currentAction == "CreateClub" ? "active" : "")"
                   asp-controller="Faculty"
                   asp-action="CreateClub">

                    <span class="faculty-sidebar-icon">➕</span>
                    <span>Create Club</span>

                </a>

                <a class="faculty-sidebar-link
                    @(currentController == "Faculty" && currentAction == "CreateEvent" ? "active" : "")"
                   asp-controller="Faculty"
                   asp-action="CreateEvent">

                    <span class="faculty-sidebar-icon">📋</span>
                    <span>Create Event</span>

                </a>

            </nav>

            <div class="faculty-sidebar-bottom">

                <div class="faculty-user-box">

                    <div class="faculty-user-name">
                        @User.Identity?.Name
                    </div>

                    <div class="faculty-user-role">
                        Faculty
                    </div>

                </div>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="/"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="faculty-logout">

                        <span>🚪</span>
                        <span>Logout</span>

                    </button>

                </form>

            </div>

        </aside>

        <main class="faculty-main">

            <header class="faculty-topbar">

                <div>
                    <div class="faculty-topbar-title">
                        @ViewData["Title"]
                    </div>

                    <div class="faculty-topbar-subtitle">
                        EventFlow Faculty Portal
                    </div>
                </div>

                <div class="faculty-topbar-user">
                    Welcome, @User.Identity?.Name
                </div>

            </header>

            <div class="faculty-content">
                @RenderBody()
            </div>

        </main>

    </div>
}
else if (isClubPresident)
{
    <!-- =========================================================
         CLUB PRESIDENT LAYOUT
         ========================================================= -->

    <div class="club-president-layout">

        <aside class="club-president-sidebar">

            <div class="club-president-brand">

                <a asp-controller="ClubPresident"
                   asp-action="Index"
                   class="club-president-brand-link">

                    <div class="club-president-brand-icon">
                        <img src="~/images/logo.png"
                             alt="EventFlow Logo" />
                    </div>

                    <div>
                        <div class="club-president-brand-title">
                            EventFlow
                        </div>

                        <div class="club-president-brand-subtitle">
                            Club President Portal
                        </div>
                    </div>

                </a>

            </div>

            <nav class="club-president-sidebar-nav">

                <!-- DASHBOARD -->

                <a class="club-president-sidebar-link
                    @(currentController == "ClubPresident" && currentAction == "Index" ? "active" : "")"
                   asp-controller="ClubPresident"
                   asp-action="Index">

                    <span class="club-president-sidebar-icon">🏠</span>
                    <span>Dashboard</span>

                </a>

                <!-- BROWSE ALL EVENTS -->

                <a class="club-president-sidebar-link
                    @(currentController == "Events" ? "active" : "")"
                   asp-controller="Events"
                   asp-action="Index">

                    <span class="club-president-sidebar-icon">📅</span>
                    <span>Browse Events</span>

                </a>

                <!-- MY CLUBS -->

                <a class="club-president-sidebar-link
                    @(currentController == "ClubPresident" &&
                      (currentAction == "AllClubs" ||
                       currentAction == "ClubDetails") ? "active" : "")"
                   asp-controller="ClubPresident"
                   asp-action="AllClubs">

                    <span class="club-president-sidebar-icon">🏛️</span>
                    <span>My Clubs</span>

                </a>

                <!-- MY CLUB EVENTS -->

                <a class="club-president-sidebar-link
                    @(currentController == "ClubPresident" &&
                      (currentAction == "Events" ||
                       currentAction == "EditEvent") ? "active" : "")"
                   asp-controller="ClubPresident"
                   asp-action="Events">

                    <span class="club-president-sidebar-icon">🎯</span>
                    <span>My Events</span>

                </a>

                <!-- MY REGISTRATIONS -->

                <a class="club-president-sidebar-link
                    @(currentController == "Registration" ? "active" : "")"
                   asp-controller="Registration"
                   asp-action="MyRegistrations">

                    <span class="club-president-sidebar-icon">🎟️</span>
                    <span>My Registrations</span>

                </a>


            </nav>

            <div class="club-president-sidebar-bottom">

                <div class="club-president-user-box">

                    <div class="club-president-user-name">
                        @User.Identity?.Name
                    </div>

                    <div class="club-president-user-role">
                        Club President
                    </div>

                </div>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="/"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="club-president-logout">

                        <span>🚪</span>
                        <span>Logout</span>

                    </button>

                </form>

            </div>

        </aside>

        <main class="club-president-main">

            <header class="club-president-topbar">

                <div>

                    <div class="club-president-topbar-title">
                        @ViewData["Title"]
                    </div>

                    <div class="club-president-topbar-subtitle">
                        EventFlow Club President Portal
                    </div>

                </div>

                <div class="club-president-topbar-user">
                    Welcome, @User.Identity?.Name
                </div>

            </header>

            <div class="club-president-content">
                @RenderBody()
            </div>

        </main>

    </div>
}
else
{
    <!-- =========================================================
         NORMAL / GUEST LAYOUT
         ========================================================= -->

    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    EventFlow
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Events"
                               asp-action="Index">
                                Events
                            </a>
                        </li>

                    </ul>

                    <partial name="_LoginPartial" />

                </div>

            </div>

        </nav>

    </header>

    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>

    <footer class="border-top footer text-muted">

        <div class="container">
            &copy; 2026 - EventFlow
        </div>

    </footer>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>