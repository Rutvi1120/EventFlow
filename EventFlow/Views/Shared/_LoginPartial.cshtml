@using Microsoft.AspNetCore.Identity
@using EventFlow.Models
@inject SignInManager<ApplicationUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="ef-auth-form">

         
        <span class="ef-user-name">
            Hi, @User.Identity?.Name
        </span>

        <form asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home")"
              method="post">

            <button type="submit" class="ef-login-btn">
                Logout
            </button>

        </form>

    </div>
 

}
else
{

    <div class="ef-auth-buttons">

         
        <a class="ef-login-btn"
           asp-area="Identity"
           asp-page="/Account/Login">
            Login
        </a>

        <a class="ef-register-btn"
           asp-area="Identity"
           asp-page="/Account/Register">

            <span>Register</span>

            <span class="ef-btn-arrow">→</span>

        </a>

    </div>
 

}
