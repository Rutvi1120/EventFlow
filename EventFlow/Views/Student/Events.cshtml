@model IEnumerable<EventFlow.Models.Event>

@{
    ViewData["Title"] = "Student Events";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Student Events</h1>
            <p class="text-muted mb-0">
                Student events you have created.
            </p>
        </div>

        <a asp-action="CreateEvent"
           class="btn btn-primary">
            Create Event
        </a>
    </div>

    <div class="mb-3 d-flex gap-2 align-items-center">
        <input id="student-events-search" class="form-control" style="max-width:360px;" type="search" placeholder="Search events..." />

        <div class="btn-group" role="group" aria-label="Filter events">
            <button type="button" class="btn btn-outline-secondary btn-sm student-events-filter active" data-filter="all">All</button>
            <button type="button" class="btn btn-outline-secondary btn-sm student-events-filter" data-filter="upcoming">Upcoming</button>
            <button type="button" class="btn btn-outline-secondary btn-sm student-events-filter" data-filter="ongoing">Ongoing</button>
            <button type="button" class="btn btn-outline-secondary btn-sm student-events-filter" data-filter="completed">Completed</button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have not created any student events.
        </div>
    }
    else
    {
        <div class="row g-4" id="student-events-list">
            @foreach (var eventItem in Model)
            {
                var startIso = eventItem.StartDateTime.ToString("o");
                var endIso = eventItem.EndDateTime.ToString("o");
                <div class="col-md-6 col-lg-4 event-card" data-name="@eventItem.Name.ToLower()" data-start="@startIso" data-end="@endIso">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                @if (eventItem.ApprovalStatus == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (eventItem.ApprovalStatus == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                            </div>

                            <h4>
                                @eventItem.Name
                            </h4>

                            <p class="text-muted">
                                @eventItem.Description
                            </p>

                            <div class="mt-auto">
                                <div class="mb-2">
                                    <strong>Date:</strong>
                                    @eventItem.StartDateTime.ToString("dd MMM yyyy")
                                </div>

                                <div class="mb-3">
                                    <strong>Venue:</strong>
                                    @(eventItem.Venue?.Name ?? "Not specified")
                                </div>

                                <div class="d-flex gap-2">
                                    <a asp-controller="Events"
                                       asp-action="Details"
                                       asp-route-id="@eventItem.Id"
                                       class="btn btn-outline-primary flex-grow-1">
                                        Details
                                    </a>

                                    @if (eventItem.ApprovalStatus != "Approved")
                                    {
                                        <a asp-action="EditEvent"
                                           asp-route-id="@eventItem.Id"
                                           class="btn btn-outline-secondary">
                                            Edit
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <script>
        (function(){
            const input = document.getElementById('student-events-search');
            const filters = document.querySelectorAll('.student-events-filter');

            function computeStatus(start, end){
                const now = new Date();
                if (now < start) return 'upcoming';
                if (now >= start && now <= end) return 'ongoing';
                return 'completed';
            }

            function applyFilter(){
                const q = input.value.trim().toLowerCase();
                const active = document.querySelector('.student-events-filter.active')?.dataset.filter || 'all';
                document.querySelectorAll('#student-events-list .event-card').forEach(el=>{
                    const name = (el.dataset.name || '').toLowerCase();
                    const start = new Date(el.dataset.start);
                    const end = new Date(el.dataset.end);
                    const status = computeStatus(start,end);

                    const matchesSearch = q === '' || name.indexOf(q) !== -1;
                    const matchesFilter = active === 'all' || active === status;

                    el.style.display = (matchesSearch && matchesFilter) ? '' : 'none';
                });
            }

            input.addEventListener('input', applyFilter);
            filters.forEach(btn=> btn.addEventListener('click', function(){
                filters.forEach(b=>b.classList.remove('active'));
                this.classList.add('active');
                applyFilter();
            }));
        })();
    </script>
</div>