@{
    ViewData["Title"] = "Student Dashboard";

    var volunteerAssignments =
        ViewBag.VolunteerAssignments as IEnumerable<EventFlow.Models.Volunteer>
        ?? Enumerable.Empty<EventFlow.Models.Volunteer>();

    var pendingCount = volunteerAssignments.Count(v =>
        v.Status == EventFlow.Models.VolunteerStatus.Pending);

    var acceptedCount = volunteerAssignments.Count(v =>
        v.Status == EventFlow.Models.VolunteerStatus.Accepted);

    var completedCount = volunteerAssignments.Count(v =>
        v.Status == EventFlow.Models.VolunteerStatus.Completed);

    var totalVolunteerCount = volunteerAssignments.Count();

    var studentName = User.Identity?.Name ?? "Student";
}

<style>
    /* =========================================================
           STUDENT DASHBOARD
           Local dashboard styles only.
           Does not modify site.css or other pages.
        ========================================================= */

    .student-dashboard-page {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* =========================================================
           WELCOME BANNER
        ========================================================= */

    .student-welcome-banner {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 190px;
        padding: 38px 45px;
        margin-bottom: 28px;
        border-radius: 24px;
        background: linear-gradient( 135deg, #312e81 0%, #4338ca 55%, #5b21b6 100% );
        color: white;
        box-shadow: 0 15px 35px rgba(67, 56, 202, 0.20);
    }

        .student-welcome-banner::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            right: 80px;
            top: -150px;
            border: 1px solid rgba(255, 255, 255, 0.13);
            border-radius: 50%;
        }

        .student-welcome-banner::after {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            right: 125px;
            top: -105px;
            border: 1px solid rgba(255, 255, 255, 0.10);
            border-radius: 50%;
        }

    .student-welcome-content {
        position: relative;
        z-index: 2;
    }

    .student-welcome-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 1.6px;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.65);
        margin-bottom: 10px;
    }

    .student-welcome-content h1 {
        font-size: 2.5rem;
        font-weight: 750;
        margin: 0 0 10px;
        color: white;
    }

    .student-welcome-content p {
        margin: 0;
        color: rgba(255, 255, 255, 0.75);
        font-size: 0.98rem;
    }

    .student-welcome-icon {
        position: relative;
        z-index: 2;
        width: 90px;
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.13);
        border: 1px solid rgba(255, 255, 255, 0.15);
        font-size: 2.4rem;
        backdrop-filter: blur(8px);
    }

    /* =========================================================
           ANALYTICS CARDS
        ========================================================= */

    .student-analytics-card {
        position: relative;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 25px;
        min-height: 180px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .student-analytics-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.07);
        }

        .student-analytics-card::after {
            content: "";
            position: absolute;
            width: 110px;
            height: 110px;
            right: -40px;
            bottom: -45px;
            border-radius: 50%;
            background: #eef2ff;
        }

    .student-analytics-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 1.35rem;
        margin-bottom: 18px;
    }

    .student-events-card .student-analytics-icon {
        background: #eef2ff;
    }

    .student-registration-card .student-analytics-icon {
        background: #ede9fe;
    }

    .student-pending-card .student-analytics-icon {
        background: #fff7ed;
    }

    .student-accepted-card .student-analytics-icon {
        background: #ecfdf5;
    }

    .student-analytics-title {
        position: relative;
        z-index: 2;
        color: #6b7280;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 7px;
    }

    .student-analytics-number {
        position: relative;
        z-index: 2;
        color: #111827;
        font-size: 2.3rem;
        line-height: 1;
        font-weight: 750;
        margin-bottom: 9px;
    }

    .student-analytics-subtitle {
        position: relative;
        z-index: 2;
        color: #9ca3af;
        font-size: 0.82rem;
    }

    /* =========================================================
           ACTIVITY / OVERVIEW
        ========================================================= */

    .student-overview-section {
        margin-top: 28px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.035);
    }

    .student-overview-header {
        margin-bottom: 22px;
    }

    .student-overview-label {
        color: #6366f1;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.4px;
        margin-bottom: 5px;
    }

    .student-overview-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 5px;
    }

    .student-overview-description {
        color: #6b7280;
        font-size: 0.88rem;
        margin: 0;
    }

    .student-overview-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 0;
        border-bottom: 1px solid #f0f1f3;
    }

        .student-overview-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .student-overview-row:first-child {
            padding-top: 0;
        }

    .student-overview-name {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #374151;
        font-size: 0.92rem;
        font-weight: 600;
    }

    .student-overview-value {
        color: #4f46e5;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .student-overview-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #6366f1;
    }

        .student-overview-dot.green {
            background: #10b981;
        }

        .student-overview-dot.orange {
            background: #f59e0b;
        }

        .student-overview-dot.blue {
            background: #0ea5e9;
        }

    /* =========================================================
           STUDENT ACTIVITY PANEL
        ========================================================= */

    .student-activity-section {
        margin-top: 28px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.035);
    }

    .student-activity-header {
        margin-bottom: 22px;
    }

    .student-activity-label {
        color: #6366f1;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.4px;
        margin-bottom: 5px;
    }

    .student-activity-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 5px;
    }

    .student-activity-description {
        color: #6b7280;
        font-size: 0.88rem;
        margin: 0;
    }

    .student-activity-empty {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 22px;
        border-radius: 15px;
        background: #f8f9fc;
        color: #6b7280;
    }

    .student-activity-empty-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #eef2ff;
        font-size: 1.3rem;
    }

    .student-activity-empty h5 {
        margin: 0 0 4px;
        color: #374151;
        font-size: 0.95rem;
        font-weight: 700;
    }

    .student-activity-empty p {
        margin: 0;
        font-size: 0.84rem;
    }

    /* =========================================================
           VOLUNTEER SUMMARY
        ========================================================= */

    .student-volunteer-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }

    .student-volunteer-stat {
        padding: 18px;
        border-radius: 15px;
        background: #f8f9fc;
        text-align: center;
    }

    .student-volunteer-stat-number {
        font-size: 1.7rem;
        font-weight: 750;
        color: #111827;
        margin-bottom: 4px;
    }

    .student-volunteer-stat-label {
        color: #6b7280;
        font-size: 0.78rem;
    }

    /* =========================================================
           RESPONSIVE
        ========================================================= */

    @@media (max-width: 900px) {

        .student-welcome-banner {
            padding: 32px 35px;
        }

        .student-welcome-content h1 {
            font-size: 2.2rem;
        }

        .student-welcome-icon {
            width: 75px;
            height: 75px;
            font-size: 2rem;
        }
    }

    @@media (max-width: 576px) {

        .student-dashboard-page {
            padding: 0 3px;
        }

        .student-welcome-banner {
            padding: 28px 25px;
            min-height: 170px;
            border-radius: 20px;
        }

        .student-welcome-content h1 {
            font-size: 1.8rem;
        }

        .student-welcome-content p {
            font-size: 0.88rem;
        }

        .student-welcome-icon {
            display: none;
        }

        .student-analytics-card {
            min-height: 160px;
        }

        .student-analytics-number {
            font-size: 2rem;
        }

        .student-overview-section,
        .student-activity-section {
            padding: 22px;
        }

        .student-volunteer-grid {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="container py-4">

    <div class="student-dashboard-page">

        <partial name="_Alerts" />


        <!-- =====================================================
             WELCOME
        ====================================================== -->

        <div class="student-welcome-banner">

            <div class="student-welcome-content">

                <div class="student-welcome-label">
                    STUDENT PORTAL
                </div>

                <h1>
                    Welcome back, @studentName 👋
                </h1>

                <p>
                    Here's an overview of your events, registrations
                    and volunteer activities.
                </p>

            </div>

            <div class="student-welcome-icon">
                🎓
            </div>

        </div>


        <!-- =====================================================
             ANALYTICS
        ====================================================== -->

        <div class="row g-4">


            <!-- MY EVENTS -->

            <div class="col-md-6 col-xl-3">

                <div class="student-analytics-card student-events-card">

                    <div class="student-analytics-icon">
                        📅
                    </div>

                    <div class="student-analytics-title">
                        My Events
                    </div>

                    <div class="student-analytics-number">
                        @ViewBag.MyEventsCount
                    </div>

                    <div class="student-analytics-subtitle">
                        Events created by you
                    </div>

                </div>

            </div>


            <!-- REGISTRATIONS -->

            <div class="col-md-6 col-xl-3">

                <div class="student-analytics-card student-registration-card">

                    <div class="student-analytics-icon">
                        🎟️
                    </div>

                    <div class="student-analytics-title">
                        Registrations
                    </div>

                    <div class="student-analytics-number">
                        @ViewBag.RegistrationsCount
                    </div>

                    <div class="student-analytics-subtitle">
                        Your event registrations
                    </div>

                </div>

            </div>


            <!-- PENDING -->

            <div class="col-md-6 col-xl-3">

                <div class="student-analytics-card student-pending-card">

                    <div class="student-analytics-icon">
                        ⏳
                    </div>

                    <div class="student-analytics-title">
                        Pending Volunteer
                    </div>

                    <div class="student-analytics-number">
                        @pendingCount
                    </div>

                    <div class="student-analytics-subtitle">
                        Applications awaiting response
                    </div>

                </div>

            </div>


            <!-- ACCEPTED -->

            <div class="col-md-6 col-xl-3">

                <div class="student-analytics-card student-accepted-card">

                    <div class="student-analytics-icon">
                        ✓
                    </div>

                    <div class="student-analytics-title">
                        Accepted Volunteer
                    </div>

                    <div class="student-analytics-number">
                        @acceptedCount
                    </div>

                    <div class="student-analytics-subtitle">
                        Active volunteer assignments
                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             CURRENT ACTIVITY
        ====================================================== -->

        <div class="student-activity-section">

            <div class="student-activity-header">

                <div class="student-activity-label">
                    CURRENT ACTIVITY
                </div>

                <h2 class="student-activity-title">
                    Your Current Activity
                </h2>

                <p class="student-activity-description">
                    A quick view of your current EventFlow activity.
                </p>

            </div>


            <div class="student-activity-empty">

                <div class="student-activity-empty-icon">
                    📅
                </div>

                <div>

                    <h5>
                        Your event activity
                    </h5>

                    <p>
                        You currently have
                        <strong>@ViewBag.MyEventsCount</strong>
                        event
                        @(Convert.ToInt32(ViewBag.MyEventsCount ?? 0) == 1
                            ? ""
                            : "s")
                        in your account and
                        <strong>@ViewBag.RegistrationsCount</strong>
                        registration
                        @(Convert.ToInt32(ViewBag.RegistrationsCount ?? 0) == 1
                            ? ""
                            : "s").
                    </p>

                </div>

            </div>

        </div>


        <!-- =====================================================
             VOLUNTEER OVERVIEW
        ====================================================== -->

        <div class="student-overview-section">

            <div class="student-overview-header">

                <div class="student-overview-label">
                    VOLUNTEER STATUS
                </div>

                <h2 class="student-overview-title">
                    Volunteer Overview
                </h2>

                <p class="student-overview-description">
                    Current status of your volunteer applications and assignments.
                </p>

            </div>


            <!-- Pending -->

            <div class="student-overview-row">

                <div class="student-overview-name">

                    <span class="student-overview-dot orange"></span>

                    Applications awaiting response

                </div>

                <div class="student-overview-value">
                    @pendingCount
                </div>

            </div>


            <!-- Accepted -->

            <div class="student-overview-row">

                <div class="student-overview-name">

                    <span class="student-overview-dot green"></span>

                    Accepted assignments

                </div>

                <div class="student-overview-value">
                    @acceptedCount
                </div>

            </div>


            <!-- Completed -->

            <div class="student-overview-row">

                <div class="student-overview-name">

                    <span class="student-overview-dot blue"></span>

                    Completed assignments

                </div>

                <div class="student-overview-value">
                    @completedCount
                </div>

            </div>


            <!-- Total -->

            <div class="student-overview-row">

                <div class="student-overview-name">

                    <span class="student-overview-dot"></span>

                    Total volunteer applications

                </div>

                <div class="student-overview-value">
                    @totalVolunteerCount
                </div>

            </div>

        </div>


        <!-- =====================================================
             VOLUNTEER BREAKDOWN
        ====================================================== -->

        <div class="student-overview-section">

            <div class="student-overview-header">

                <div class="student-overview-label">
                    VOLUNTEER JOURNEY
                </div>

                <h2 class="student-overview-title">
                    Your Progress
                </h2>

                <p class="student-overview-description">
                    A summary of your volunteer journey in EventFlow.
                </p>

            </div>


            <div class="student-volunteer-grid">

                <div class="student-volunteer-stat">

                    <div class="student-volunteer-stat-number">
                        @pendingCount
                    </div>

                    <div class="student-volunteer-stat-label">
                        Pending
                    </div>

                </div>


                <div class="student-volunteer-stat">

                    <div class="student-volunteer-stat-number">
                        @acceptedCount
                    </div>

                    <div class="student-volunteer-stat-label">
                        Accepted
                    </div>

                </div>


                <div class="student-volunteer-stat">

                    <div class="student-volunteer-stat-number">
                        @completedCount
                    </div>

                    <div class="student-volunteer-stat-label">
                        Completed
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>