@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Student Dashboard</h1>
        <p class="text-muted">
            Manage your events, registrations, and volunteer activities.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>Browse Events</h5>
                    <p class="text-muted">
                        Discover approved college events.
                    </p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>Create Event</h5>
                    <p class="text-muted">
                        Create a new student event.
                    </p>

                    <a asp-controller="Student"
                       asp-action="CreateEvent"
                       class="btn btn-primary">
                        Create Event
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>My Events</h5>
                    <p class="text-muted">
                        Manage events you have created.
                    </p>

                    <a asp-controller="Student"
                       asp-action="MyEvents"
                       class="btn btn-primary">
                        My Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>Registrations</h5>
                    <p class="text-muted">
                        View your event registrations.
                    </p>

                    <a asp-controller="Registration"
                       asp-action="MyRegistrations"
                       class="btn btn-primary">
                        My Registrations
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>