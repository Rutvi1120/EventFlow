
@{
    ViewData["Title"] = "Student Dashboard";

    var volunteerAssignments =
        ViewBag.VolunteerAssignments as IEnumerable<EventFlow.Models.Volunteer>
        ?? Enumerable.Empty<EventFlow.Models.Volunteer>();

    var pendingCount = volunteerAssignments.Count(v =>
        v.Status == EventFlow.Models.VolunteerStatus.Pending);

    var acceptedCount = volunteerAssignments.Count(v =>
        v.Status == EventFlow.Models.VolunteerStatus.Accepted);

    var completedCount = volunteerAssignments.Count(v =>
        v.Status == EventFlow.Models.VolunteerStatus.Completed);

    var totalVolunteerCount = volunteerAssignments.Count();
}

<style>
    body {
        background: #f7f9fc;
    }

    .dashboard-header {
        background: linear-gradient(135deg, #0d6efd, #6f42c1);
        color: white;
        border-radius: 24px;
        padding: 35px;
        margin-bottom: 30px;
        box-shadow: 0 15px 35px rgba(13, 110, 253, 0.15);
    }

        .dashboard-header h1 {
            font-weight: 800;
            margin-bottom: 8px;
        }

        .dashboard-header p {
            margin-bottom: 0;
            color: rgba(255,255,255,0.8);
        }

    .header-icon {
        width: 70px;
        height: 70px;
        border-radius: 20px;
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 35px;
    }

    .stat-card {
        background: white;
        border: none;
        border-radius: 18px;
        padding: 24px;
        height: 100%;
        box-shadow: 0 8px 25px rgba(32, 56, 85, 0.07);
        transition: 0.25s ease;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(32, 56, 85, 0.11);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        margin-bottom: 15px;
    }

    .stat-number {
        font-size: 30px;
        font-weight: 800;
        color: #172033;
    }

    .stat-label {
        color: #667085;
        font-size: 14px;
    }

    .section-title {
        font-weight: 800;
        color: #172033;
    }

    .action-card {
        background: white;
        border: 1px solid #edf0f5;
        border-radius: 20px;
        padding: 25px;
        height: 100%;
        transition: 0.25s ease;
    }

        .action-card:hover {
            transform: translateY(-6px);
            border-color: transparent;
            box-shadow: 0 15px 35px rgba(32, 56, 85, 0.1);
        }

    .action-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 18px;
    }

    .action-card h5 {
        font-weight: 700;
        color: #172033;
    }

    .action-card p {
        color: #667085;
        min-height: 48px;
    }

    .btn-dashboard {
        border-radius: 10px;
        padding: 9px 18px;
        font-weight: 600;
    }

    .volunteer-card {
        background: white;
        border-radius: 20px;
        padding: 25px;
        border: 1px solid #edf0f5;
        height: 100%;
    }

        .volunteer-card h5 {
            font-weight: 700;
        }

    .status-number {
        font-size: 26px;
        font-weight: 800;
    }

    .status-item {
        padding: 15px;
        border-radius: 14px;
        background: #f8f9fc;
    }

    .action-needed {
        border: 2px solid #198754;
        background: linear-gradient( 135deg, rgba(25, 135, 84, 0.06), rgba(255,255,255,1) );
    }

    .quick-section {
        margin-top: 45px;
    }

    .empty-volunteer {
        padding: 25px;
        background: #f8f9fc;
        border-radius: 15px;
        text-align: center;
        color: #667085;
    }

    @@media (max-width: 768px) {
        .dashboard-header {
            padding: 25px;
        }

        .header-icon {
            display: none;
        }
    }
</style>


<div class="container py-4">

    <!-- ================= HEADER ================= -->

    <div class="dashboard-header">

        <div class="row align-items-center">

            <div class="col">

                <div class="small mb-2">
                    STUDENT PORTAL
                </div>

                <h1>
                    Welcome back! 👋
                </h1>

                <p>
                    Manage your events, registrations and volunteer
                    activities from one place.
                </p>

            </div>

            <div class="col-auto">

                <div class="header-icon">
                    🎓
                </div>

            </div>

        </div>

    </div>


    <partial name="_Alerts" />


    <!-- ================= VOLUNTEER STATS ================= -->

    <div class="row g-4 mb-5">

        <div class="col-6 col-lg-3">

            <div class="stat-card">

                <div class="stat-icon bg-primary-subtle text-primary">
                    📅
                </div>

                <div class="stat-number">
                    @ViewBag.MyEventsCount
                </div>

                <div class="stat-label">
                    My Events
                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="stat-card">

                <div class="stat-icon bg-info-subtle text-info">
                    🎟️
                </div>

                <div class="stat-number">
                    @ViewBag.RegistrationsCount
                </div>

                <div class="stat-label">
                    Registrations
                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="stat-card">

                <div class="stat-icon bg-warning-subtle text-warning">
                    ⏳
                </div>

                <div class="stat-number">
                    @pendingCount
                </div>

                <div class="stat-label">
                    Pending Volunteer
                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="stat-card">

                <div class="stat-icon bg-success-subtle text-success">
                    ✓
                </div>

                <div class="stat-number">
                    @acceptedCount
                </div>

                <div class="stat-label">
                    Accepted Volunteer
                </div>

            </div>

        </div>

    </div>


    <!-- ================= EVENT MANAGEMENT ================= -->

    <div class="quick-section">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h3 class="section-title mb-1">
                    Event Management
                </h3>

                <p class="text-muted mb-0">
                    Discover and manage your college events.
                </p>
            </div>

        </div>


        <div class="row g-4">

            <!-- Browse Events -->

            <div class="col-md-6 col-lg-3">

                <div class="action-card">

                    <div class="action-icon bg-primary-subtle text-primary">
                        🔎
                    </div>

                    <h5>
                        Browse Events
                    </h5>

                    <p>
                        Discover approved college events,
                        workshops and activities.
                    </p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary btn-dashboard">
                        View Events →
                    </a>

                </div>

            </div>


            <!-- Create Event -->

            <div class="col-md-6 col-lg-3">

                <div class="action-card">

                    <div class="action-icon bg-success-subtle text-success">
                        ➕
                    </div>

                    <h5>
                        Create Event
                    </h5>

                    <p>
                        Create a new student event and
                        organize activities.
                    </p>

                    <a asp-controller="Student"
                       asp-action="CreateEvent"
                       class="btn btn-success btn-dashboard">
                        Create Event →
                    </a>

                </div>

            </div>


            <!-- My Events -->

            <div class="col-md-6 col-lg-3">

                <div class="action-card">

                    <div class="action-icon bg-warning-subtle text-warning">
                        📋
                    </div>

                    <h5>
                        My Events
                    </h5>

                    <p>
                        Manage events that you have
                        created.
                    </p>

                    <a asp-controller="Student"
                       asp-action="MyEvents"
                       class="btn btn-warning btn-dashboard">
                        My Events →
                    </a>

                </div>

            </div>


            <!-- Registrations -->

            <div class="col-md-6 col-lg-3">

                <div class="action-card">

                    <div class="action-icon bg-info-subtle text-info">
                        🎟️
                    </div>

                    <h5>
                        Registrations
                    </h5>

                    <p>
                        View and manage your event
                        registrations.
                    </p>

                    <a asp-controller="Registration"
                       asp-action="MyRegistrations"
                       class="btn btn-info btn-dashboard">
                        My Registrations →
                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= VOLUNTEERING ================= -->

    <div class="quick-section">

        <div class="mb-4">

            <h3 class="section-title mb-1">
                Volunteer Center 🤝
            </h3>

            <p class="text-muted mb-0">
                Find opportunities and manage your volunteer assignments.
            </p>

        </div>


        <div class="row g-4">

            <!-- Browse Volunteer Events -->

            <div class="col-md-6 col-lg-4">

                <div class="volunteer-card">

                    <span class="badge bg-success mb-3">
                        OPPORTUNITIES
                    </span>

                    <h5>
                        Browse Volunteer Events
                    </h5>

                    <p class="text-muted">
                        Find approved upcoming events and
                        apply for available volunteer roles.
                    </p>

                    <a asp-controller="Volunteer"
                       asp-action="Index"
                       class="btn btn-success btn-dashboard">
                        Find Opportunities →
                    </a>

                </div>

            </div>


            <!-- Applications -->

            <div class="col-md-6 col-lg-4">

                <div class="volunteer-card">

                    <span class="badge bg-primary mb-3">
                        MY APPLICATIONS
                    </span>

                    <h5>
                        Volunteer Applications
                    </h5>

                    <div class="row g-2 mt-3 mb-3">

                        <div class="col-4">

                            <div class="status-item text-center">

                                <div class="status-number text-warning">
                                    @pendingCount
                                </div>

                                <small class="text-muted">
                                    Pending
                                </small>

                            </div>

                        </div>


                        <div class="col-4">

                            <div class="status-item text-center">

                                <div class="status-number text-success">
                                    @acceptedCount
                                </div>

                                <small class="text-muted">
                                    Accepted
                                </small>

                            </div>

                        </div>


                        <div class="col-4">

                            <div class="status-item text-center">

                                <div class="status-number text-primary">
                                    @completedCount
                                </div>

                                <small class="text-muted">
                                    Completed
                                </small>

                            </div>

                        </div>

                    </div>

                    <a asp-controller="Volunteer"
                       asp-action="MyApplications"
                       class="btn btn-primary btn-dashboard">
                        View Applications →
                    </a>

                </div>

            </div>


            <!-- Accepted Assignment -->
            @if (acceptedCount > 0)
            {
                <div class="col-md-12 col-lg-4">

                    <div class="volunteer-card action-needed">

                        <span class="badge bg-success mb-3">
                            ACTION NEEDED
                        </span>

                        <h5>
                            Volunteer Work in Progress
                        </h5>

                        <p class="text-muted">
                            You currently have
                            <strong>@acceptedCount</strong>
                            accepted
                            @(acceptedCount == 1
                                ? "assignment"
                                : "assignments").
                        </p>

                        <div class="alert alert-success py-2">
                            ✓ Complete your volunteer work
                            when the event activity is finished.
                        </div>

                        <a asp-controller="Volunteer"
                           asp-action="MyApplications"
                           class="btn btn-outline-success btn-dashboard">
                            View Assignments →
                        </a>

                    </div>

                </div>
            }
            else
            {
                <div class="col-md-12 col-lg-4">

                    <div class="volunteer-card">

                        <span class="badge bg-secondary mb-3">
                            STATUS
                        </span>

                        <h5>
                            No Active Assignment
                        </h5>

                        <p class="text-muted">
                            You currently don't have any accepted
                            volunteer assignments.
                        </p>

                        <a asp-controller="Volunteer"
                           asp-action="Index"
                           class="btn btn-outline-success btn-dashboard">
                            Find Opportunities →
                        </a>

                    </div>

                </div>
            }

        </div>

    </div>


    <!-- ================= VOLUNTEER SUMMARY ================= -->

    <div class="quick-section mb-5">

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-4">

                <div class="row align-items-center">

                    <div class="col-md-8">

                        <span class="badge bg-light text-primary mb-2">
                            VOLUNTEER JOURNEY
                        </span>

                        <h4 class="fw-bold">
                            Your volunteer progress
                        </h4>

                        <p class="text-muted mb-0">
                            You have submitted
                            <strong>@totalVolunteerCount</strong>
                            volunteer
                            @(totalVolunteerCount == 1
                                ? "application"
                                : "applications")
                            so far.
                        </p>

                    </div>

                    <div class="col-md-4 text-md-end mt-3 mt-md-0">

                        <a asp-controller="Volunteer"
                           asp-action="MyApplications"
                           class="btn btn-primary btn-dashboard">
                            View My Journey →
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

