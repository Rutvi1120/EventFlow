@model IEnumerable<EventFlow.Models.Event>

@{
    ViewData["Title"] = "My Student Events";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>My Student Events</h1>

            <p class="text-muted mb-0">
                Manage the student events you have created.
            </p>
        </div>

        <a asp-action="CreateEvent"
           class="btn btn-primary">
            Create Event
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have not created any student events.
        </div>
    }
    else
    {
        <div class="mb-3 d-flex gap-2 align-items-center">

            <div class="btn-group"
                 role="group"
                 aria-label="Filter events">

                <button type="button"
                        class="btn btn-outline-secondary btn-sm student-myevents-filter active"
                        data-filter="all">
                    All
                </button>

                <button type="button"
                        class="btn btn-outline-secondary btn-sm student-myevents-filter"
                        data-filter="upcoming">
                    Upcoming
                </button>

                <button type="button"
                        class="btn btn-outline-secondary btn-sm student-myevents-filter"
                        data-filter="ongoing">
                    Ongoing
                </button>

                <button type="button"
                        class="btn btn-outline-secondary btn-sm student-myevents-filter"
                        data-filter="completed">
                    Completed
                </button>

            </div>

        </div>

        <div class="table-responsive"
             id="student-myevents-list">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-end">Details</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var eventItem in Model)
                    {
                        var startIso = eventItem.StartDateTime.ToString("o");
                        var endIso = eventItem.EndDateTime.ToString("o");

                        <tr class="event-row"
                            data-name="@eventItem.Name.ToLower()"
                            data-start="@startIso"
                            data-end="@endIso">

                            <td>
                                <strong>
                                    @eventItem.Name
                                </strong>
                            </td>

                            <td>
                                @eventItem.StartDateTime.ToString(
                                    "dd MMM yyyy hh:mm tt")
                            </td>

                            <td>
                                @if (eventItem.ApprovalStatus == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (eventItem.ApprovalStatus == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                            </td>

                <td>
                    <div class="d-flex justify-content-end gap-2 flex-wrap">

                        <!-- Details button -->
                        <a asp-controller="Events"
                           asp-action="Details"
                           asp-route-id="@eventItem.Id"
                           class="btn btn-sm btn-outline-primary">
                            Details
                        </a>

                        <!-- Edit and Delete buttons -->
                        @if (eventItem.ApprovalStatus != "Approved")
                        {
                            <a asp-controller="Student"
                               asp-action="EditEvent"
                               asp-route-id="@eventItem.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Edit
                            </a>

                            <form asp-controller="Student"
                                  asp-action="DeleteEvent"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this event?');">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@eventItem.Id" />

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger">
                                    Delete
                                </button>
                            </form>
                        }

                     </div>
                </td>



                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
</div>

<script>
    (function() {

        const filters =
            document.querySelectorAll('.student-myevents-filter');

        function computeStatus(start, end) {

            const now = new Date();

            if (now < start) {
                return 'upcoming';
            }

            if (now >= start && now <= end) {
                return 'ongoing';
            }

            return 'completed';
        }

        function applyFilter() {

            const active =
                document.querySelector(
                    '.student-myevents-filter.active'
                )?.dataset.filter || 'all';

            document
                .querySelectorAll(
                    '#student-myevents-list .event-row'
                )
                .forEach(el => {

                    const start =
                        new Date(el.dataset.start);

                    const end =
                        new Date(el.dataset.end);

                    const status =
                        computeStatus(start, end);

                    const matchesFilter =
                        active === 'all' ||
                        active === status;

                    el.style.display =
                        matchesFilter ? '' : 'none';
                });
        }

        filters.forEach(btn => {

            btn.addEventListener('click', function() {

                filters.forEach(b =>
                    b.classList.remove('active')
                );

                this.classList.add('active');

                applyFilter();
            });

        });

        applyFilter();

    })();
</script>
