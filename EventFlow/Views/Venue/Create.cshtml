@model EventFlow.Models.Venue

@{
    ViewData["Title"] = "Create Venue";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Create Venue</h1>
        <p class="text-muted">
            Add a venue for college events.
        </p>
    </div>

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name"
                                   class="form-label">
                                Venue Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter venue name" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Location"
                                   class="form-label">
                                Location
                            </label>

                            <input asp-for="Location"
                                   class="form-control"
                                   placeholder="Enter venue location" />

                            <span asp-validation-for="Location"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Capacity"
                                   class="form-label">
                                Capacity
                            </label>

                            <input asp-for="Capacity"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="Enter maximum capacity" />

                            <span asp-validation-for="Capacity"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                Create Venue
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}