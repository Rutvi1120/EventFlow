@model EventFlow.Models.VolunteerApplyViewModel

@{
    ViewData["Title"] = "Apply as Volunteer";

    var eventItem = Model.Event;
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-controller="Volunteer"
           asp-action="Index"
           class="text-decoration-none">
            &larr; Back to Volunteer Events
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">

            <partial name="_Alerts" />

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h2 class="mb-1">Volunteer Application</h2>

                    @if (eventItem != null)
                    {
                        <p class="text-muted mb-4">
                            Apply to volunteer for <strong>@eventItem.Name</strong>
                        </p>

                        <div class="alert alert-light border">
                            <div><strong>Event:</strong> @eventItem.Name</div>
                            <div>
                                <strong>Date:</strong>
                                @eventItem.StartDateTime.ToString("dd MMM yyyy")
                            </div>
                            <div>
                                <strong>Time:</strong>
                                @eventItem.StartDateTime.ToString("hh:mm tt")
                                -
                                @eventItem.EndDateTime.ToString("hh:mm tt")
                            </div>
                            <div>
                                <strong>Venue:</strong>
                                @(eventItem.Venue?.Name ?? "Not specified")
                            </div>
                            <div>
                                <strong>Type:</strong> @eventItem.EventType
                                @if (eventItem.Club != null)
                                {
                                    <span>- @eventItem.Club.Name</span>
                                }
                            </div>
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <form asp-controller="Volunteer"
                          asp-action="Apply"
                          method="post">

                        <input type="hidden" asp-for="EventId" />

                        <div class="alert alert-info mb-4">
                            <strong>Volunteer application:</strong> You are applying to volunteer for this event.
                            The event creator will decide your volunteer work after your application is accepted.
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label">Notes (optional)</label>
                            <textarea asp-for="Notes"
                                      class="form-control"
                                      rows="4"
                                      maxlength="1000"
                                      placeholder="Anything the organizer should know about your volunteer application"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                Submit Application
                            </button>

                            <a asp-controller="Volunteer"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
