@model IEnumerable<EventFlow.Models.Volunteer>

@{
    ViewData["Title"] = "My Assignments";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>My Assignments</h1>

            <p class="text-muted">
                All events assigned to you as a volunteer.
            </p>
        </div>

        <a asp-action="Dashboard"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <!-- ASSIGNMENTS -->
    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Venue</th>
                                <th>Role</th>
                                <th>Notes</th>
                                <th>Event Date</th>
                                <th>Status</th>
                                <th>Assigned At</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var assignment in Model)
                            {
                                <tr>

                                    <!-- EVENT -->
                                    <td>
                                        <strong>
                                            @assignment.Event?.Name
                                        </strong>
                                    </td>


                                    <!-- VENUE -->
                                    <td>
                                        @assignment.Event?.Venue?.Name
                                    </td>


                                    <!-- ROLE -->
                                    <td>
                                        @assignment.Role
                                    </td>


                                    <!-- NOTES -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(assignment.Notes))
                                        {
                                            @assignment.Notes
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No notes
                                            </span>
                                        }
                                    </td>


                                    <!-- EVENT DATE -->
                                    <td>
                                        @if (assignment.Event != null)
                                        {
                                            <span>
                                                @assignment.Event.StartDateTime.ToString("dd MMM yyyy")
                                            </span>

                                            <br />

                                            <small class="text-muted">
                                                @assignment.Event.StartDateTime.ToString("hh:mm tt")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No event
                                            </span>
                                        }
                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        @if (assignment.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (assignment.Status == "Accepted")
                                        {
                                            <span class="badge bg-primary">
                                                Accepted
                                            </span>
                                        }
                                        else if (assignment.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @assignment.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- ASSIGNED AT -->
                                    <td>
                                        @assignment.AssignedAt.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                                    </td>


                                    <!-- ACTIONS -->
                                    <td>

                                        <!-- VIEW -->
                                        <a asp-action="Details"
                                           asp-route-id="@assignment.Id"
                                           class="btn btn-sm btn-primary mb-1">
                                            View
                                        </a>


                                        <!-- ACCEPT / REJECT -->
                                        @if (assignment.Status == "Assigned")
                                        {
                                            <!-- ACCEPT -->
                                            <form asp-action="AcceptAssignment"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@assignment.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-success mb-1">
                                                    Accept
                                                </button>

                                            </form>


                                            <!-- REJECT -->
                                            <form asp-action="RejectAssignment"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to reject this assignment?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@assignment.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger mb-1">
                                                    Reject
                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- NO ASSIGNMENTS -->
        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <h4>No Volunteer Assignments</h4>

                <p class="text-muted">
                    You have not been assigned to any events yet.
                </p>

                <a asp-action="Dashboard"
                   class="btn btn-primary">
                    Go to Dashboard
                </a>

            </div>

        </div>
    }

</div>