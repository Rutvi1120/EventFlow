@model IEnumerable<EventFlow.Models.Volunteer>

@{
    ViewData["Title"] = "Volunteer Dashboard";
}

<div class="ef-dashboard">

     
    <div class="ef-dashboard-container">

        <!-- HEADER -->
        <div class="ef-dashboard-header">

            <div>
                <h1 class="ef-dashboard-title">
                    Volunteer Dashboard
                </h1>

                <p class="ef-dashboard-subtitle">
                    Manage your volunteer assignments and event activities.
                </p>
            </div>

            <div class="ef-dashboard-actions">

                <a asp-controller="Volunteer"
                   asp-action="Assignment"
                   class="ef-dashboard-btn ef-dashboard-btn-primary">
                    My Assignments
                </a>

            </div>

        </div>


        <!-- STAT CARDS -->
        <div class="ef-stat-grid">

            <div class="ef-stat-card">

                <span class="ef-stat-label">
                    Total Assignments
                </span>

                <div class="ef-stat-value">
                    @ViewBag.TotalAssignments
                </div>

                <div class="ef-stat-icon">
                    ◈
                </div>

            </div>


            <div class="ef-stat-card">

                <span class="ef-stat-label">
                    Active
                </span>

                <div class="ef-stat-value">
                    @ViewBag.ActiveAssignments
                </div>

                <div class="ef-stat-icon">
                    ●
                </div>

            </div>


            <div class="ef-stat-card">

                <span class="ef-stat-label">
                    Upcoming
                </span>

                <div class="ef-stat-value">
                    @ViewBag.UpcomingAssignments
                </div>

                <div class="ef-stat-icon">
                    ◷
                </div>

            </div>


            <div class="ef-stat-card">

                <span class="ef-stat-label">
                    Completed
                </span>

                <div class="ef-stat-value">
                    @ViewBag.CompletedAssignments
                </div>

                <div class="ef-stat-icon">
                    ✓
                </div>

            </div>

        </div>


        <!-- ASSIGNMENTS -->
        <div class="ef-dashboard-panel">

            <div class="ef-panel-header">

                <h2 class="ef-panel-title">
                    My Assignments
                </h2>

                <a asp-controller="Volunteer"
                   asp-action="Assignment"
                   class="ef-panel-link">
                    View all →
                </a>

            </div>


            <div class="ef-event-list">

                @if (Model != null && Model.Any())
                {
                    foreach (var assignment in Model.Take(5))
                    {
                        <div class="ef-event-item">

                            <div class="ef-event-date">

                                <span class="ef-event-date-day">
                                    @assignment.Event.StartDateTime.Day
                                </span>

                                <span class="ef-event-date-month">
                                    @assignment.Event.StartDateTime.ToString("MMM")
                                </span>

                            </div>


                            <div class="ef-event-info">

                                <h3 class="ef-event-name">
                                    @assignment.Event.Name
                                </h3>

                                <div class="ef-event-meta">
                                    @assignment.Role
                                </div>

                            </div>


                            <span class="ef-status
                                @(assignment.Status == "Completed"
                                    ? "ef-status-completed"
                                    : assignment.Status == "Accepted"
                                        ? "ef-status-ongoing"
                                        : assignment.Status == "Rejected"
                                            ? "ef-status-delayed"
                                            : "ef-status-upcoming")">

                                @assignment.Status

                            </span>


                            <a asp-controller="Volunteer"
                               asp-action="Details"
                               asp-route-id="@assignment.Id"
                               class="ef-panel-link">
                                View →
                            </a>

                        </div>
                    }
                }
                else
                {
                    <div class="ef-empty-state">

                        <div class="ef-empty-icon">
                            +
                        </div>

                        <p>
                            No volunteer assignments yet.
                        </p>

                    </div>
                }

            </div>

        </div>


        <!-- QUICK ACTIONS -->
        <div class="ef-dashboard-panel">

            <div class="ef-panel-header">

                <h2 class="ef-panel-title">
                    Quick Actions
                </h2>

            </div>


            <div class="ef-quick-actions">

                <a asp-controller="Volunteer"
                   asp-action="Assignment"
                   class="ef-quick-action">

                    <span class="ef-quick-icon">
                        ◈
                    </span>

                    <span class="ef-quick-text">

                        <span class="ef-quick-title">
                            My Assignments
                        </span>

                        <span class="ef-quick-description">
                            View and manage your assignments
                        </span>

                    </span>

                </a>


                <a asp-controller="Home"
                   asp-action="Index"
                   class="ef-quick-action">

                    <span class="ef-quick-icon">
                        ←
                    </span>

                    <span class="ef-quick-text">

                        <span class="ef-quick-title">
                            Home
                        </span>

                        <span class="ef-quick-description">
                            Return to EventFlow home
                        </span>

                    </span>

                </a>

            </div>

        </div>

    </div>
     

</div>
