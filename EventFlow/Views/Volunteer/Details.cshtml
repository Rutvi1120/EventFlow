@model EventFlow.Models.Volunteer

@{
    ViewData["Title"] = "Assignment Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Assignment Details</h1>
            <p class="text-muted">
                View your volunteer assignment information.
            </p>
        </div>

        <a asp-action="Assignment"
           class="btn btn-outline-secondary">
            Back to Assignments
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row">

        <div class="col-md-8">

            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <h4 class="mb-0">Event Information</h4>
                </div>

                <div class="card-body">

                    <dl class="row">

                        <dt class="col-sm-4">
                            Event
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Event?.Name
                        </dd>

                        <dt class="col-sm-4">
                            Description
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Event?.Description
                        </dd>

                        <dt class="col-sm-4">
                            Venue
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Event?.Venue?.Name
                        </dd>

                        <dt class="col-sm-4">
                            Start
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Event?.StartDateTime.ToString("dd MMM yyyy hh:mm tt")
                        </dd>

                        <dt class="col-sm-4">
                            End
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Event?.EndDateTime.ToString("dd MMM yyyy hh:mm tt")
                        </dd>

                    </dl>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <h4 class="mb-0">Assignment</h4>
                </div>

                <div class="card-body">

                    <p>
                        <strong>Role:</strong>
                        @Model.Role
                    </p>

                    <p>
                        <strong>Status:</strong>

                        @if (Model.Status == "Completed")
                        {
                            <span class="badge bg-success">
                                Completed
                            </span>
                        }
                        else if (Model.Status == "Accepted")
                        {
                            <span class="badge bg-primary">
                                Accepted
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                @Model.Status
                            </span>
                        }
                    </p>

                    <p>
                        <strong>Assigned:</strong>
                        @Model.AssignedAt
                            .ToLocalTime()
                            .ToString("dd MMM yyyy hh:mm tt")
                    </p>

                    @if (Model.CompletedAt.HasValue)
                    {
                        <p>
                            <strong>Completed:</strong>
                            @Model.CompletedAt.Value
                                .ToLocalTime()
                                .ToString("dd MMM yyyy hh:mm tt")
                        </p>
                    }

                    <hr />

                    <form asp-action="UpdateStatus"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <div class="mb-3">

                            <label class="form-label">
                                Update Status
                            </label>

                            <select name="status"
                                    class="form-select">

                                <option value="Assigned"
                                    selected="@(Model.Status == "Assigned")">
                                    Assigned
                                </option>

                                <option value="Accepted"
                                    selected="@(Model.Status == "Accepted")">
                                    Accepted
                                </option>

                                <option value="Completed"
                                    selected="@(Model.Status == "Completed")">
                                    Completed
                                </option>

                            </select>

                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Update Status
                        </button>

                    </form>

                </div>

            </div>

            <div class="card shadow-sm">

                <div class="card-header">
                    <h5 class="mb-0">Notes</h5>
                </div>

                <div class="card-body">

                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <p class="mb-0">
                            @Model.Notes
                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No notes provided.
                        </p>
                    }

                </div>

            </div>

        </div>

    </div>

</div>