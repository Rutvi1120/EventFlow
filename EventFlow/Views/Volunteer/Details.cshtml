@model EventFlow.Models.Volunteer

@{
    ViewData["Title"] = "Assignment Details";
}

<div class="card shadow-sm mb-4">

    <div class="card-header">
        <h4 class="mb-0">Assignment</h4>
    </div>

    <div class="card-body">

        <p>
            <strong>Role:</strong>
            @Model.Role
        </p>

        <p>
            <strong>Status:</strong>

            @if (Model.Status == "Completed")
            {
                <span class="badge bg-success">
                    Completed
                </span>
            }
            else if (Model.Status == "Accepted")
            {
                <span class="badge bg-primary">
                    Accepted
                </span>
            }
            else if (Model.Status == "Rejected")
            {
                <span class="badge bg-danger">
                    Rejected
                </span>
            }
            else
            {
                <span class="badge bg-warning text-dark">
                    @Model.Status
                </span>
            }
        </p>

        <p>
            <strong>Assigned:</strong>
            @Model.AssignedAt.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
        </p>

        @if (Model.CompletedAt.HasValue)
        {
            <p>
                <strong>Completed:</strong>
                @Model.CompletedAt.Value.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
            </p>
        }

        <hr />

        @if (Model.Status == "Assigned")
        {
            <div class="d-grid gap-2">

                <form asp-action="AcceptAssignment"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-success">
                        Accept Assignment
                    </button>

                </form>

                <form asp-action="RejectAssignment"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to reject this assignment?');">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-danger">
                        Reject Assignment
                    </button>

                </form>

            </div>
        }
        else if (Model.Status == "Accepted")
        {
            <form asp-action="MarkCompleted"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-success w-100">
                    Mark Assignment as Completed
                </button>

            </form>
        }
        else if (Model.Status == "Completed")
        {
            <div class="alert alert-success mb-0">
                This assignment has been completed.
            </div>
        }
        else if (Model.Status == "Rejected")
        {
            <div class="alert alert-danger mb-0">
                You rejected this volunteer assignment.
            </div>
        }
        <a asp-action="Assignment"
       class="btn btn-outline-secondary">
        ← Back to Assignments
        </a>
    </div>

