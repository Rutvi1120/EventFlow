@model IEnumerable<EventFlow.Models.Event>

@{
    ViewData["Title"] = "Volunteer Opportunities";

    var myApplications =
        ViewBag.MyApplications as Dictionary<int, string>
        ?? new Dictionary<int, string>();
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="fw-bold mb-1">Volunteer Opportunities</h1>
            <p class="text-muted mb-0">
                Approved upcoming events that need volunteers. Pick an event and apply.
            </p>
        </div>

        <a asp-controller="Volunteer"
           asp-action="MyApplications"
           class="btn btn-primary">
            My Applications
        </a>
    </div>

    <partial name="_Alerts" />

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="display-6 mb-3">🙌</div>
                <h4>No volunteer events right now</h4>
                <p class="text-muted mb-0">
                    There are no approved upcoming events at the moment. Please check back soon.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var eventItem in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">

                            <div class="mb-2 d-flex flex-wrap gap-1">
                                <span class="badge bg-primary">@eventItem.EventType</span>
                                <partial name="_EventStatusBadge" model="eventItem" />
                            </div>

                            <h4 class="card-title">@eventItem.Name</h4>

                            @if (eventItem.Club != null)
                            {
                                <p class="text-muted small mb-2">
                                    Organized by @eventItem.Club.Name
                                </p>
                            }

                            <ul class="list-unstyled mb-3">
                                <li>
                                    <strong>Date:</strong>
                                    @eventItem.StartDateTime.ToString("dd MMM yyyy")
                                </li>
                                <li>
                                    <strong>Time:</strong>
                                    @eventItem.StartDateTime.ToString("hh:mm tt")
                                    -
                                    @eventItem.EndDateTime.ToString("hh:mm tt")
                                </li>
                                <li>
                                    <strong>Venue:</strong>
                                    @(eventItem.Venue?.Name ?? "Not specified")
                                </li>
                            </ul>

                            <div class="mt-auto d-flex gap-2">
                                @if (myApplications.TryGetValue(eventItem.Id, out var myStatus))
                                {
                                    <div class="flex-grow-1 d-flex align-items-center gap-2">
                                        <span class="text-muted">Your application:</span>
                                        <partial name="_VolunteerStatusBadge" model="myStatus" />
                                    </div>

                                    <a asp-controller="Volunteer"
                                       asp-action="MyApplications"
                                       class="btn btn-outline-secondary btn-sm">
                                        View
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Volunteer"
                                       asp-action="Apply"
                                       asp-route-eventId="@eventItem.Id"
                                       class="btn btn-success flex-grow-1">
                                        Apply as Volunteer
                                    </a>

                                    <a asp-controller="Events"
                                       asp-action="Details"
                                       asp-route-id="@eventItem.Id"
                                       class="btn btn-outline-secondary">
                                        Details
                                    </a>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
